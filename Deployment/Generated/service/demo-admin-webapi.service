[Unit]
Description=demo-admin-webapi

[Service]
WorkingDirectory=/var/appdata/demo/adminwebapi
EnvironmentFile=-/var/appdata/demo/config/shared.env
EnvironmentFile=-/var/appdata/demo/config/admin-webapi.env
ExecStart=/var/appdata/demo/adminwebapi/Admin.WebAPI --urls="http://127.0.0.1:30011"
Restart=always
RestartSec=60
KillSignal=SIGINT
SyslogIdentifier=demo-admin-webapi
User=root

[Install]
WantedBy=multi-user.target
