@page "/operations/queuetask"
@using Application.Model.TaskCenter
@attribute [ReuseTabsPageTitle("队列任务")]

<div class="queue-task-log-page admin-page">
    <div class="queue-task-log-page__hero admin-page__hero admin-page__hero--without-actions">
        <div>
            <div class="queue-task-log-page__eyebrow admin-page__eyebrow">Operations</div>
            <h2 class="queue-task-log-page__title admin-page__title">队列任务中心</h2>
            <div class="queue-task-log-page__subtitle admin-page__subtitle">按参数关键字、执行结果和创建时间检索队列任务，集中查看调度状态、执行轨迹与回调上下文，便于定位失败任务并快速触发重试</div>
        </div>

        <div class="queue-task-log-page__stats admin-page__stats">
            <div class="queue-task-log-page__stat-card admin-page__stat-card">
                <span class="queue-task-log-page__stat-label admin-page__stat-label">任务总量</span>
                <strong class="queue-task-log-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="queue-task-log-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 条记录</span>
            </div>

            <div class="queue-task-log-page__stat-card admin-page__stat-card">
                <span class="queue-task-log-page__stat-label admin-page__stat-label">结果筛选</span>
                <strong class="queue-task-log-page__stat-value queue-task-log-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@SuccessFilterText()</strong>
                <span class="queue-task-log-page__stat-foot admin-page__stat-foot">@(string.IsNullOrWhiteSpace(request.ParameterKeyword) ? "未设置参数关键字过滤" : "参数关键字过滤中")</span>
            </div>

            <div class="queue-task-log-page__stat-card admin-page__stat-card">
                <span class="queue-task-log-page__stat-label admin-page__stat-label">时间窗口</span>
                <strong class="queue-task-log-page__stat-value queue-task-log-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@DateRangeText()</strong>
                <span class="queue-task-log-page__stat-foot admin-page__stat-foot">第 @request.Page 页 / 每页 @request.PageSize 条</span>
            </div>
        </div>
    </div>

    <Card Class="queue-task-log-page__card queue-task-log-page__card--compact admin-page__card admin-page__card--compact admin-page__card--filter">
        <Form Class="queue-task-log-page__filter-form admin-form admin-filter-form" Model="@request" Layout="@FormLayout.Inline" OnFinish="HandleSearchAsync">
            <FormItem Class="queue-task-log-page__filter-item queue-task-log-page__filter-item--keyword admin-filter-form__item--keyword">
                <Input @bind-Value="@context.ParameterKeyword" Placeholder="参数 JSON / 关键字 模糊检索" AllowClear />
            </FormItem>

            <FormItem Class="queue-task-log-page__filter-item queue-task-log-page__filter-item--status admin-filter-form__item--status">
                <Select TItem="bool?" TItemValue="bool?" @bind-Value="@context.IsSuccess" Placeholder="是否成功" AllowClear>
                    <SelectOption Value="@((bool?)true)" Label="成功"></SelectOption>
                    <SelectOption Value="@((bool?)false)" Label="未成功"></SelectOption>
                </Select>
            </FormItem>

            <FormItem Class="queue-task-log-page__filter-item queue-task-log-page__filter-item--time admin-filter-form__item--time">
                <DatePicker @bind-Value="@context.StartCreateTime" Format="yyyy-MM-dd HH:mm:ss" ShowTime="@true" Placeholder="@("创建开始")" />
            </FormItem>

            <FormItem Class="queue-task-log-page__filter-item queue-task-log-page__filter-item--time admin-filter-form__item--time">
                <DatePicker @bind-Value="@context.EndCreateTime" Format="yyyy-MM-dd HH:mm:ss" ShowTime="@true" Placeholder="@("创建结束")" />
            </FormItem>

            <FormItem Class="queue-task-log-page__filter-item queue-task-log-page__filter-item--actions admin-filter-form__item--actions">
                <div class="queue-task-log-page__filter-actions admin-filter-form__actions">
                    <Button Class="queue-task-log-page__action-button queue-task-log-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit">搜索任务</Button>
                    <Button Class="queue-task-log-page__action-button queue-task-log-page__action-button--default admin-page-button admin-page-button--default" OnClick="HandleReset">重置条件</Button>
                </div>
            </FormItem>
        </Form>
    </Card>

    <Card Class="queue-task-log-page__card queue-task-log-page__card--compact admin-page__card admin-page__card--compact">
        <div class="queue-task-log-page__list-shell admin-page-list-shell">
            <div class="queue-task-log-page__table-wrap admin-page__table-wrap">
                <Table TItem="QueueTaskDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="任务">
                            <div class="queue-task-log-page__task-cell">
                                <div class="queue-task-log-page__task-name" title="@context.Name">@context.Name</div>
                                <div class="queue-task-log-page__task-sub" title="@context.CallbackName">@(string.IsNullOrWhiteSpace(context.CallbackName) ? "无回调任务" : "回调: " + context.CallbackName)</div>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="状态">
                            <Tag Class="queue-task-log-page__status-tag admin-page__status-tag" Color="@StatusTagColor(context.Status)">@FormatStatus(context.Status)</Tag>
                        </ActionColumn>

                        <ActionColumn Title="结果">
                            <Tag Class="queue-task-log-page__status-tag admin-page__status-tag" Color="@SuccessTagColor(context.SuccessTime)">@SuccessText(context.SuccessTime)</Tag>
                        </ActionColumn>

                        <ActionColumn Title="计划时间">
                            <div class="queue-task-log-page__time-cell">@FormatTime(context.PlanTime)</div>
                        </ActionColumn>

                        <ActionColumn Title="最后执行">
                            <div class="queue-task-log-page__time-cell">@FormatTime(context.LastTime)</div>
                        </ActionColumn>

                        <ActionColumn Title="次数">
                            <div class="queue-task-log-page__count-pill">@context.Count</div>
                        </ActionColumn>

                        <ActionColumn Title="父任务">
                            <div class="queue-task-log-page__mono-text">@(context.ParentTaskId?.ToString() ?? "-")</div>
                        </ActionColumn>

                        <ActionColumn Title="创建时间">
                            <div class="queue-task-log-page__time-cell">@FormatTime(context.CreateTime)</div>
                        </ActionColumn>

                        <ActionColumn Title="操作">
                            <Space>
                                @if (functionList.Contains("queuetask"))
                                {
                                    <SpaceItem>
                                        <a class="queue-task-log-page__link admin-page__link" @onclick="() => ViewQueueTask(context)">详情</a>
                                    </SpaceItem>
                                }

                                @if (context.SuccessTime == null && context.Count > 0)
                                {
                                    <SpaceItem>
                                        <Popconfirm Title="确认要重试吗？将重置执行次数/时间并重新触发"
                                                    OnConfirm="_=>RetryQueueTaskAsync(context.Id)"
                                                    OkText="Yes"
                                                    CancelText="No">
                                            <a class="queue-task-log-page__link queue-task-log-page__link--warn">重试</a>
                                        </Popconfirm>
                                    </SpaceItem>
                                }
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="queue-task-log-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="@request.PageSize" Current="@request.Page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="1180" Visible="isShowDetail" Title='("队列任务详情")' OnClose="() => isShowDetail = false">
    <Template>
        <div class="queue-task-log-drawer admin-detail-drawer">
            <div class="queue-task-log-drawer__overview admin-detail-drawer__overview">
                <div class="queue-task-log-drawer__summary admin-detail-drawer__summary">
                    <div class="queue-task-log-drawer__summary-main">
                        <div class="queue-task-log-drawer__summary-eyebrow admin-detail-drawer__summary-eyebrow">Queue Task</div>
                        <div class="queue-task-log-drawer__summary-title admin-detail-drawer__summary-title">@(string.IsNullOrWhiteSpace(detail?.Name) ? "未命名任务" : detail!.Name)</div>
                        <div class="queue-task-log-drawer__summary-subtitle admin-detail-drawer__summary-subtitle">任务 ID：@(detail == null ? "-" : detail.Id.ToString()) / 回调任务：@(string.IsNullOrWhiteSpace(detail?.CallbackName) ? "-" : detail!.CallbackName)</div>
                    </div>

                    <div class="queue-task-log-drawer__summary-meta admin-detail-drawer__summary-meta">
                        <Tag Class="queue-task-log-drawer__summary-tag admin-page__status-tag" Color="@StatusTagColor(detail?.Status)">@FormatStatus(detail?.Status)</Tag>
                        <Tag Class="queue-task-log-drawer__summary-tag admin-page__status-tag" Color="@SuccessTagColor(detail?.SuccessTime)">@SuccessText(detail?.SuccessTime)</Tag>
                        <span class="queue-task-log-drawer__meta-pill admin-detail-drawer__meta-pill">创建：@FormatTime(detail?.CreateTime)</span>
                    </div>
                </div>

                <div class="queue-task-log-drawer__meta-grid admin-detail-drawer__meta-grid">
                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">执行实例</span>
                        <span class="queue-task-log-drawer__meta-value queue-task-log-drawer__meta-value--mono admin-detail-drawer__meta-value admin-detail-drawer__meta-value--mono">@(string.IsNullOrWhiteSpace(detail?.WorkerId) ? "-" : detail!.WorkerId)</span>
                    </div>

                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">计划时间</span>
                        <span class="queue-task-log-drawer__meta-value admin-detail-drawer__meta-value">@FormatTime(detail?.PlanTime)</span>
                    </div>

                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">执行次数</span>
                        <span class="queue-task-log-drawer__meta-value admin-detail-drawer__meta-value">@(detail == null ? "-" : detail.Count.ToString())</span>
                    </div>

                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">首次执行</span>
                        <span class="queue-task-log-drawer__meta-value admin-detail-drawer__meta-value">@FormatTime(detail?.FirstTime)</span>
                    </div>

                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">最后执行</span>
                        <span class="queue-task-log-drawer__meta-value admin-detail-drawer__meta-value">@FormatTime(detail?.LastTime)</span>
                    </div>

                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">成功时间</span>
                        <span class="queue-task-log-drawer__meta-value admin-detail-drawer__meta-value">@FormatTime(detail?.SuccessTime)</span>
                    </div>

                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">租约到期</span>
                        <span class="queue-task-log-drawer__meta-value admin-detail-drawer__meta-value">@FormatTime(detail?.LeaseExpireTime)</span>
                    </div>

                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">子任务成功</span>
                        <span class="queue-task-log-drawer__meta-value admin-detail-drawer__meta-value">@FormatTime(detail?.ChildSuccessTime)</span>
                    </div>

                    <div class="queue-task-log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="queue-task-log-drawer__meta-label admin-detail-drawer__meta-label">父任务 ID</span>
                        <span class="queue-task-log-drawer__meta-value queue-task-log-drawer__meta-value--mono admin-detail-drawer__meta-value admin-detail-drawer__meta-value--mono">@(detail?.ParentTaskId?.ToString() ?? "-")</span>
                    </div>
                </div>
            </div>

            <div class="queue-task-log-drawer__content-grid admin-detail-drawer__content-grid">
                <div class="queue-task-log-drawer__content-box admin-detail-drawer__content-box">
                    <div class="queue-task-log-drawer__content-toolbar admin-detail-drawer__content-toolbar">
                        <span class="queue-task-log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="queue-task-log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="queue-task-log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="queue-task-log-drawer__content-caption admin-detail-drawer__content-caption">参数 JSON</span>
                    </div>

                    <TextArea Value="@detailParameter" ReadOnly />
                </div>

                <div class="queue-task-log-drawer__content-box admin-detail-drawer__content-box">
                    <div class="queue-task-log-drawer__content-toolbar admin-detail-drawer__content-toolbar">
                        <span class="queue-task-log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="queue-task-log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="queue-task-log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="queue-task-log-drawer__content-caption admin-detail-drawer__content-caption">回调参数 JSON</span>
                    </div>

                    <TextArea Value="@detailCallbackParameter" ReadOnly />
                </div>
            </div>
        </div>
    </Template>
</Drawer>



@code {

    List<string> functionList = new();

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();
    }

    override protected async Task OnParametersSetAsync()
    {
        await GetQueueTaskListAsync();
    }

    QueueTaskPageRequestDto request = new() { PageSize = 10 };

    bool tableLoading = false;
    PageListDto<QueueTaskDto> pageList = new();

    async Task GetQueueTaskListAsync()
    {
        tableLoading = true;

        var url = StringHelper.ModelToUriParam(request, "Operations/GetQueueTaskList");
        var retData = await Http.GetFromJsonAsync<PageListDto<QueueTaskDto>>(url, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task HandleSearchAsync(EditContext editContext)
    {
        request.Page = 1;
        await GetQueueTaskListAsync();
    }

    async Task HandleReset()
    {
        request = new QueueTaskPageRequestDto { PageSize = request.PageSize };
        await GetQueueTaskListAsync();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (request.Page != args.Page)
        {
            request.Page = args.Page;
        }

        if (request.PageSize != args.PageSize)
        {
            request.PageSize = args.PageSize;
        }

        await GetQueueTaskListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";

    bool isShowDetail = false;
    QueueTaskDto? detail;
    string? detailParameter;
    string? detailCallbackParameter;

    void ViewQueueTask(QueueTaskDto row)
    {
        detail = row;
        detailParameter = row.Parameter;
        detailCallbackParameter = row.CallbackParameter;
        isShowDetail = true;
        StateHasChanged();
    }

    async Task RetryQueueTaskAsync(long id)
    {
        try
        {
            using var httpResponse = await Http.PostAsync("Operations/RetryQueueTask?id=" + id, null);

            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("已触发重试");
                await GetQueueTaskListAsync();
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("重试失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
    }


    /// <summary>
    /// 返回结果筛选的展示文案
    /// </summary>
    string SuccessFilterText() => request.IsSuccess switch
    {
        true => "仅成功任务",
        false => "仅未成功",
        _ => "全部结果"
    };


    /// <summary>
    /// 返回时间筛选区间展示文案
    /// </summary>
    string DateRangeText()
    {
        if (request.StartCreateTime == null && request.EndCreateTime == null)
        {
            return "全部时间";
        }

        var startText = request.StartCreateTime?.ToString("MM-dd HH:mm") ?? "不限开始";
        var endText = request.EndCreateTime?.ToString("MM-dd HH:mm") ?? "不限结束";
        return startText + " ~ " + endText;
    }


    /// <summary>
    /// 返回任务状态标签颜色
    /// </summary>
    static string StatusTagColor(int? status) => status switch
    {
        0 => "#94a3b8",
        1 => "#2563eb",
        2 => "#16a34a",
        3 => "#dc2626",
        _ => "#94a3b8"
    };


    /// <summary>
    /// 返回成功结果标签颜色
    /// </summary>
    static string SuccessTagColor(DateTimeOffset? successTime) => successTime == null ? "#f59e0b" : "#16a34a";


    /// <summary>
    /// 返回成功结果展示文案
    /// </summary>
    static string SuccessText(DateTimeOffset? successTime) => successTime == null ? "未成功" : "成功";


    /// <summary>
    /// 返回任务状态展示文案
    /// </summary>
    static string? FormatStatus(int? status) => status switch
    {
        0 => "待领取",
        1 => "执行中",
        2 => "成功",
        3 => "失败",
        null => "-",
        _ => status.ToString()
    };


    /// <summary>
    /// 返回时间展示文案
    /// </summary>
    static string FormatTime(DateTimeOffset? time) => time?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "-";
}
