@page "/operations/queuetasksetting"
@using Application.Model.TaskCenter
@attribute [ReuseTabsPageTitle("队列任务配置")]

<div class="queue-task-page admin-page">
    <div class="queue-task-page__hero admin-page__hero admin-page__hero--with-actions">
        <div>
            <div class="queue-task-page__eyebrow admin-page__eyebrow">Operations</div>
            <h2 class="queue-task-page__title admin-page__title">队列任务配置台</h2>
            <div class="queue-task-page__subtitle admin-page__subtitle">集中维护 QueueTask 分类任务的启停状态、并发额度与备注说明，让队列消费能力调整和日常运维管理都在一个视图内完成</div>

            <div class="queue-task-page__hero-tools admin-page__hero-tools">
                <Button Class="queue-task-page__hero-button queue-task-page__hero-button--light admin-page-button admin-page-button--default" Icon="reload" OnClick="GetTaskSettingListAsync">刷新列表</Button>
            </div>
        </div>

        <div class="queue-task-page__stats admin-page__stats">
            <div class="queue-task-page__stat-card admin-page__stat-card">
                <span class="queue-task-page__stat-label admin-page__stat-label">任务总量</span>
                <strong class="queue-task-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="queue-task-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 条配置</span>
            </div>

            <div class="queue-task-page__stat-card admin-page__stat-card">
                <span class="queue-task-page__stat-label admin-page__stat-label">当前页启用</span>
                <strong class="queue-task-page__stat-value admin-page__stat-value">@(pageList.List?.Count(t => t.IsEnable) ?? 0)</strong>
                <span class="queue-task-page__stat-foot admin-page__stat-foot">便于快速观察当前页投产中的任务数量</span>
            </div>

            <div class="queue-task-page__stat-card admin-page__stat-card">
                <span class="queue-task-page__stat-label admin-page__stat-label">分页状态</span>
                <strong class="queue-task-page__stat-value queue-task-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">第 @(page) 页 / 每页 @pageSize 条</strong>
                <span class="queue-task-page__stat-foot admin-page__stat-foot">当前分类固定为 QueueTask</span>
            </div>
        </div>
    </div>

    <Card Class="queue-task-page__card queue-task-page__card--compact admin-page__card admin-page__card--compact">
        <div class="queue-task-page__list-shell admin-page-list-shell">
            <div class="queue-task-page__table-wrap admin-page__table-wrap">
                <Table TItem="TaskSettingDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="任务">
                            <div class="queue-task-page__name-cell admin-page__name-cell">
                                <div class="queue-task-page__name-title admin-page__name-title">@context.Name</div>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="状态">
                            <Tag Class="queue-task-page__status-tag admin-page__status-tag" Color="@(context.IsEnable ? "#16a34a" : "#94a3b8")">@(context.IsEnable ? "启用中" : "已停用")</Tag>
                        </ActionColumn>

                        <ActionColumn Title="并发">
                            <div class="queue-task-page__semaphore-pill">@context.Semaphore</div>
                        </ActionColumn>

                        <ActionColumn Title="备注">
                            <div class="queue-task-page__remark-cell admin-page__remark-cell">@(string.IsNullOrWhiteSpace(context.Remark) ? "暂无备注说明" : context.Remark)</div>
                        </ActionColumn>

                        <PropertyColumn Property="c => (c.UpdateTime ?? c.CreateTime).LocalDateTime" Format="yyyy-MM-dd HH:mm" Title="更新时间"></PropertyColumn>

                        <ActionColumn Title="操作">
                            <Space>
                                <SpaceItem>
                                    <a class="queue-task-page__link admin-page__link" @onclick="() => EditTaskSettingAsync(context)">编辑</a>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="queue-task-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="pageSize" Current="page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="620" Visible="isShowEditTaskSetting" Title='("任务配置")' OnClose="() => isShowEditTaskSetting = false">
    <Template>
        <div class="queue-task-drawer admin-drawer">
            <Form Class="queue-task-drawer__form admin-drawer__form admin-form" Model="@editTaskSetting" Layout="@FormLayout.Vertical" OnFinish="SaveTaskSettingAsync">
                <div class="queue-task-drawer__section admin-drawer__section">
                    <div class="queue-task-drawer__section-head admin-drawer__section-head">
                        <div>
                            <div class="queue-task-drawer__section-title admin-drawer__section-title">基础配置</div>
                        </div>

                        <div class="queue-task-drawer__switch-box admin-drawer__switch-box">
                            <span class="queue-task-drawer__switch-label admin-drawer__switch-label">是否启用</span>
                            <Switch @bind-Value="@editTaskSetting.IsEnable" CheckedChildren="是" UnCheckedChildren="否" />
                        </div>
                    </div>

                    <div class="queue-task-drawer__meta-grid admin-drawer__meta-grid">
                        <div class="queue-task-drawer__meta-item admin-drawer__meta-item">
                            <span class="queue-task-drawer__meta-label admin-drawer__meta-label">任务名称</span>
                            <span class="queue-task-drawer__meta-value admin-drawer__meta-value">@(string.IsNullOrWhiteSpace(taskName) ? "-" : taskName)</span>
                        </div>

                        <div class="queue-task-drawer__meta-item admin-drawer__meta-item">
                            <span class="queue-task-drawer__meta-label admin-drawer__meta-label">任务类型</span>
                            <span class="queue-task-drawer__meta-value admin-drawer__meta-value">@(string.IsNullOrWhiteSpace(taskCategory) ? "-" : taskCategory)</span>
                        </div>
                    </div>

                    <FormItem Class="queue-task-drawer__field-item admin-form__field-item">
                        <div class="queue-task-drawer__field-label admin-form__field-label">并发</div>
                        <Input Placeholder="QueueTask 并发值" Type="InputType.Number" min="1" @bind-Value="@editTaskSetting.Semaphore" />
                        <div class="queue-task-drawer__field-help admin-form__field-help">建议结合消费者实例数和单任务耗时设置并发额度，避免任务堆积或竞争过载</div>
                    </FormItem>

                    <FormItem Class="queue-task-drawer__field-item admin-form__field-item">
                        <div class="queue-task-drawer__field-label admin-form__field-label">备注</div>
                        <TextArea Placeholder="请输入备注" @bind-Value="@editTaskSetting.Remark" MinRows="4" MaxRows="8" />
                    </FormItem>
                </div>

                <div class="queue-task-drawer__footer admin-drawer__footer">
                    <Button Class="queue-task-page__action-button queue-task-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Loading="@saveLoading">保存</Button>
                    <Button Class="queue-task-page__action-button queue-task-page__action-button--default admin-page-button admin-page-button--default" Type="@ButtonType.Default" @onclick="() => isShowEditTaskSetting = false">取消</Button>
                </div>
            </Form>
        </div>
    </Template>
</Drawer>



@code {

    List<string> functionList = new();

    const string PageCategory = "QueueTask";

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();
    }

    override protected async Task OnParametersSetAsync()
    {
        await GetTaskSettingListAsync();
    }

    bool tableLoading = false;
    int page = 1;
    int pageSize = 10;
    PageListDto<TaskSettingDto> pageList = new();


    async Task GetTaskSettingListAsync()
    {
        tableLoading = true;

        var retData = await Http.GetFromJsonAsync<PageListDto<TaskSettingDto>>("Operations/GetTaskSettingList?page=" + page + "&pageSize=" + pageSize + "&category=" + PageCategory, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (page != args.Page)
        {
            page = args.Page;
        }

        if (pageSize != args.PageSize)
        {
            pageSize = args.PageSize;
        }

        await GetTaskSettingListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";

    bool isShowEditTaskSetting = false;
    bool saveLoading = false;

    long taskSettingId;
    string? taskName;
    string? taskCategory;
    EditTaskSettingDto editTaskSetting = new();

    async Task EditTaskSettingAsync(TaskSettingDto taskSetting)
    {
        taskSettingId = taskSetting.Id;

        taskName = taskSetting.Name;
        taskCategory = taskSetting.Category;

        editTaskSetting = new EditTaskSettingDto
        {
            IsEnable = taskSetting.IsEnable,
            Cron = taskSetting.Cron,
            Semaphore = taskSetting.Semaphore,
            Parameter = taskSetting.Parameter,
            Remark = taskSetting.Remark
        };

        await Task.Delay(200);

        isShowEditTaskSetting = true;

        StateHasChanged();
    }

    async Task SaveTaskSettingAsync()
    {
        saveLoading = true;
        try
        {
            using var httpResponse = await Http.PostAsJsonAsync<EditTaskSettingDto>("Operations/UpdateTaskSetting?taskSettingId=" + taskSettingId, editTaskSetting, JsonHelper.SerializeOpts);

            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("编辑成功");
                isShowEditTaskSetting = false;
                await GetTaskSettingListAsync();
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("编辑失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            saveLoading = false;
            StateHasChanged();
        }
    }
}
