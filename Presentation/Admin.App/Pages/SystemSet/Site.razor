@page "/systemset/site"
@using Application.Model.Site.Site
@attribute [ReuseTabsPageTitle("信息维护")]

<div class="site-setting-page admin-page">
    <Card Class="site-setting-page__panel admin-page__card admin-page__card--body-panel">
        <Tabs Class="site-setting-page__tabs" Type="@TabType.Line">

            <TabPane Key="1" Tab="站点信息">
                <div class="site-setting-page__section-card">
                    <Form Class="site-setting-page__inner-form admin-form" Model="@editSite" Layout="@FormLayout.Vertical">
                        <div class="site-setting-page__field-grid site-setting-page__field-grid--wide admin-form__field-grid">
                            <FormItem Label="网站 Url">
                                <Input Placeholder="请输入网站 Url" @bind-Value="@editSite.WebUrl" AllowClear />
                            </FormItem>

                            <FormItem Label="备案号">
                                <Input Placeholder="请输入备案号" @bind-Value="@editSite.RecordNumber" AllowClear />
                            </FormItem>

                            <FormItem Label="管理者名称">
                                <Input Placeholder="请输入管理者名称" @bind-Value="@editSite.ManagerName" AllowClear />
                            </FormItem>

                            <FormItem Label="联系电话">
                                <Input Placeholder="请输入联系电话" @bind-Value="@editSite.ManagerPhone" AllowClear />
                            </FormItem>

                            <FormItem Label="管理者地址">
                                <Input Placeholder="请输入管理者地址" @bind-Value="@editSite.ManagerAddress" AllowClear />
                            </FormItem>

                            <FormItem Label="邮箱">
                                <Input Placeholder="请输入邮箱" @bind-Value="@editSite.ManagerEmail" AllowClear />
                            </FormItem>
                        </div>
                    </Form>
                </div>

                <div class="site-setting-page__section-card site-setting-page__section-card--wide">
                    <Form Class="site-setting-page__inner-form" Model="@editSite" Layout="@FormLayout.Vertical">
                        <FormItem Label="代码内容">
                            <div class="site-setting-page__field-help">适合放置统计脚本、站点验证代码或页脚扩展内容，保存后会参与页面底部输出</div>
                            <TextArea Class="site-setting-page__textarea site-setting-page__textarea--foot-code" ShowCount Placeholder="请输入自定义代码，将放置在页面底部" @bind-Value="@editSite.FootCode" MinRows="6" MaxRows="12" />
                        </FormItem>
                    </Form>
                </div>
            </TabPane>

            <TabPane Key="2" Tab="SEO 参数" ForceRender="true">
                <Row Gutter="24">
                    <AntDesign.Col Span="12">
                        <div class="site-setting-page__section-card">
                            <Form Class="site-setting-page__inner-form admin-form" Model="@editSite" Layout="@FormLayout.Vertical">
                                <FormItem Label="SEO 标题">
                                    <div class="site-setting-page__field-help">用于定义搜索结果的主标题和站点关键词，建议避免重复堆词</div>
                                    <TextArea Class="site-setting-page__textarea site-setting-page__textarea--seo-short" ShowCount Placeholder="请输入 SEO 标题" @bind-Value="@editSite.SeoTitle" MinRows="4" MaxRows="6" />
                                </FormItem>

                                <FormItem Label="SEO 关键字">
                                    <TextArea Class="site-setting-page__textarea site-setting-page__textarea--seo-short" ShowCount Placeholder="请输入 SEO 关键字" @bind-Value="@editSite.SeoKeywords" MinRows="4" MaxRows="6" />
                                </FormItem>
                            </Form>
                        </div>
                    </AntDesign.Col>

                    <AntDesign.Col Span="12">
                        <div class="site-setting-page__section-card">
                            <Form Class="site-setting-page__inner-form admin-form" Model="@editSite" Layout="@FormLayout.Vertical">
                                <FormItem Label="SEO 描述">
                                    <div class="site-setting-page__field-help">描述建议突出站点服务对象、核心能力和可信信息，让搜索结果更完整</div>
                                    <TextArea Class="site-setting-page__textarea site-setting-page__textarea--seo-description" ShowCount Placeholder="请输入 SEO 描述" @bind-Value="@editSite.SeoDescription" MinRows="8" MaxRows="10" />
                                </FormItem>
                            </Form>

                            <div class="site-setting-page__preview-list">
                                <div class="site-setting-page__preview-item">
                                    <span>标题长度</span>
                                    <strong>@CountTextLength(editSite.SeoTitle) 字</strong>
                                </div>
                                <div class="site-setting-page__preview-item">
                                    <span>关键字长度</span>
                                    <strong>@CountTextLength(editSite.SeoKeywords) 字</strong>
                                </div>
                                <div class="site-setting-page__preview-item">
                                    <span>描述长度</span>
                                    <strong>@CountTextLength(editSite.SeoDescription) 字</strong>
                                </div>
                            </div>
                        </div>
                    </AntDesign.Col>
                </Row>
            </TabPane>

        </Tabs>

        <div class="site-setting-page__footer">
            <Button Class="site-setting-page__save-button admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" Loading="@saveLoading" OnClick="SaveSiteAsync">保存更改</Button>
        </div>
    </Card>
</div>


@code {

    /// <summary>
    /// 站点编辑模型
    /// </summary>
    SiteDto editSite = new();


    /// <summary>
    /// 保存按钮加载状态
    /// </summary>
    bool saveLoading = false;


    /// <summary>
    /// 初始化页面并加载站点信息
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var response = await Http.GetAsync("Site/GetSite");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var retData = await response.Content.ReadFromJsonAsync<SiteDto>(JsonHelper.DeserializeOpts);
            if (retData != null)
            {
                editSite = retData;
            }
        }
        catch (OperationCanceledException)
        {
            // ignore
        }
        catch (HttpRequestException)
        {
            // interceptor handles 401/400; don't crash WASM runtime
        }
    }


    /// <summary>
    /// 保存站点信息
    /// </summary>
    async Task SaveSiteAsync()
    {
        saveLoading = true;
        try
        {
            using var httpResponse = await Http.PostAsJsonAsync<SiteDto>("Site/EditSite", editSite, JsonHelper.SerializeOpts);
            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("保存成功");
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("保存失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            saveLoading = false;
            StateHasChanged();
        }
    }


    /// <summary>
    /// 统计文本长度
    /// </summary>
    int CountTextLength(string? text) => string.IsNullOrWhiteSpace(text) ? 0 : text.Trim().Length;

}
