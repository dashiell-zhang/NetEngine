# 示例，不会被生成的服务自动加载
# 将共享配置写入 {{DeployRoot}}/config/shared.env，并设置仅服务账号可读的权限
# 每个宿主可通过 client-webapi.env、admin-webapi.env、task-service.env 覆盖本业务配置
# 替换全部占位值后再使用，真实凭据不要提交到仓库

# 同一唯一性范围的所有发号服务必须使用相同 ID 协调目标及库编号
ConnectionStrings__idRedisConnection="<shared-id-redis>:6379,defaultDatabase=0,password=<password>"

# 共享日志存储的连接、维护锁和稳定目标标识应一致
ConnectionStrings__logConnection="Host=<log-db>;Database=<log-database>;Username=<writer>;Password=<password>;Maximum Pool Size=10"
ConnectionStrings__logRedisConnection="<shared-log-redis>:6379,defaultDatabase=0,password=<password>"
DatabaseIdentity__Log="{{ProjectNameLower}}.SharedLogs"

# Redis 广播互通实例使用相同目标、库编号、Scope 和保留期
EventBus__Provider="Redis"
EventBus__Scope="{{ProjectNameLower}}:Production"
ConnectionStrings__eventBusRedisConnection="<shared-event-redis>:6379,defaultDatabase=0,password=<password>"

# Database 广播模式改用以下连接，并将 EventBus__Provider 设为 Database
# ConnectionStrings__eventBusConnection="Host=<event-db>;Database=<event-database>;Username=<writer>;Password=<password>;Maximum Pool Size=10"

# 以下配置按所属业务模块填写，可放入各宿主自己的 env 文件
# ConnectionStrings__dbConnection="Host=<business-db>;Database=<business-database>;Username=<writer>;Password=<password>;Maximum Pool Size=20"
# ConnectionStrings__dbReadConnection="Host=<business-reader>;Database=<business-database>;Username=<reader>;Password=<password>;Maximum Pool Size=10"
# ConnectionStrings__redisConnection="<business-redis>:6379,defaultDatabase=<module-number>,password=<password>"
# DatabaseIdentity__Business="{{ProjectNameLower}}.Business"
# DatabaseLogger__Project="<stable-project-name>"
# DatabaseLogger__SaveDays="14"

# 管理端日志查询可单独配置只读目标，未配置时使用日志写库
# ConnectionStrings__logReadConnection="Host=<log-reader>;Database=<log-database>;Username=<reader>;Password=<password>;Maximum Pool Size=10"
