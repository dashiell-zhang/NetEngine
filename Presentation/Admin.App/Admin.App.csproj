<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net11.0-browser</TargetFramework>
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
		<!--<StaticWebAssetBasePath>admin</StaticWebAssetBasePath>-->
		<!--<PublishIISAssets>true</PublishIISAssets>-->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<NoWarn>4014;8618</NoWarn>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<NoWarn>4014;8618</NoWarn>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AntDesign" Version="1.6.3-dotnet11.rc3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
		<PackageReference Include="SkiaSharp.Views.Blazor" Version="4.156.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Application\Application.Model\Application.Model.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\Common\Common.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\DistributedLock.InMemory\DistributedLock.InMemory.csproj" />
	</ItemGroup>

	<Target Name="CleanObjRelease" BeforeTargets="BeforeClean">
		<Message Text="CleanObjRelease" Importance="high" />
		<RemoveDir Directories="$(BaseIntermediateOutputPath)\Release\" />
	</Target>
</Project>
