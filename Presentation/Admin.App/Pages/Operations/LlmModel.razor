@page "/operations/llmmodel"
@using Application.Model.LLM.LlmModel
@using System.Net.Http.Json
@attribute [ReuseTabsPageTitle("LLM模型管理")]

<div class="llm-model-page admin-page">
    <div class="llm-model-page__hero admin-page__hero admin-page-hero--with-actions">
        <div>
            <div class="llm-model-page__eyebrow admin-page__eyebrow">Operations</div>
            <h2 class="llm-model-page__title admin-page__title">LLM 模型管理台</h2>
            <div class="llm-model-page__subtitle admin-page__subtitle">统一维护模型名称、端点地址、协议类型与密钥配置，让模型切换、停启用和后续应用接入都在同一处完成</div>

            <div class="llm-model-page__hero-tools admin-page__hero-tools">
                <Button Class="llm-model-page__hero-button admin-page-button admin-page-button--primary admin-page-button--with-plus" Type="@ButtonType.Primary" @onclick="() => EditLlmModel()"><span class="admin-page-button__content"><span class="admin-page-button__icon" aria-hidden="true">+</span><span class="admin-page-button__text">新增模型</span><span class="admin-page-button__spacer" aria-hidden="true"></span></span></Button>
            </div>
        </div>

        <div class="llm-model-page__stats admin-page__stats">
            <div class="llm-model-page__stat-card admin-page__stat-card">
                <span class="llm-model-page__stat-label admin-page__stat-label">模型总量</span>
                <strong class="llm-model-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="llm-model-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 条记录</span>
            </div>

            <div class="llm-model-page__stat-card admin-page__stat-card">
                <span class="llm-model-page__stat-label admin-page__stat-label">启用筛选</span>
                <strong class="llm-model-page__stat-value llm-model-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@(request.IsEnable == null ? "全部模型" : request.IsEnable.Value ? "仅启用" : "仅停用")</strong>
                <span class="llm-model-page__stat-foot admin-page__stat-foot">快速聚焦正在对外提供服务的模型</span>
            </div>

            <div class="llm-model-page__stat-card admin-page__stat-card">
                <span class="llm-model-page__stat-label admin-page__stat-label">检索状态</span>
                <strong class="llm-model-page__stat-value llm-model-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@(string.IsNullOrWhiteSpace(request.Keyword) ? "全部模型" : "关键词检索")</strong>
                <span class="llm-model-page__stat-foot admin-page__stat-foot">第 @request.Page 页 / 每页 @request.PageSize 条</span>
            </div>
        </div>
    </div>

    <Card Class="llm-model-page__card llm-model-page__card--compact admin-page__card admin-page__card--compact admin-page__card--filter">
        <Form Class="llm-model-page__filter-form admin-form admin-filter-form" Model="@request" Layout="@FormLayout.Inline" OnFinish="HandleSearchAsync">
            <FormItem Class="llm-model-page__filter-item llm-model-page__filter-item--keyword admin-filter-form__item--keyword">
                <Input @bind-Value="@context.Keyword" Placeholder="名称 / 模型标识 / 备注 模糊检索" AllowClear />
            </FormItem>

            <FormItem Class="llm-model-page__filter-item llm-model-page__filter-item--status admin-filter-form__item--status">
                <Select TItem="bool?" TItemValue="bool?" @bind-Value="@context.IsEnable" Placeholder="请选择状态" AllowClear>
                    <SelectOption Value="@((bool?)true)" Label="启用"></SelectOption>
                    <SelectOption Value="@((bool?)false)" Label="停用"></SelectOption>
                </Select>
            </FormItem>

            <FormItem Class="llm-model-page__filter-item llm-model-page__filter-item--actions admin-filter-form__item--actions">
                <div class="llm-model-page__filter-actions admin-filter-form__actions">
                    <Button Class="llm-model-page__action-button llm-model-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit">搜索模型</Button>
                    <Button Class="llm-model-page__action-button llm-model-page__action-button--default admin-page-button admin-page-button--default" OnClick="HandleReset">重置条件</Button>
                </div>
            </FormItem>
        </Form>
    </Card>

    <Card Class="llm-model-page__card llm-model-page__card--compact admin-page__card admin-page__card--compact">
        <div class="llm-model-page__list-shell admin-page-list-shell">
            <div class="llm-model-page__table-wrap admin-page__table-wrap">
                <Table TItem="LlmModelDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="模型">
                            <div class="llm-model-page__name-cell admin-page__name-cell">
                                <div class="llm-model-page__name-title admin-page__name-title">@context.Name</div>
                                <div class="llm-model-page__name-sub">@(string.IsNullOrWhiteSpace(context.Remark) ? "暂无备注说明" : context.Remark)</div>
                            </div>
                        </ActionColumn>

                        <PropertyColumn Property="c => c.ModelId" Title="模型标识"></PropertyColumn>

                        <ActionColumn Title="端点地址">
                            <div class="llm-model-page__endpoint">@context.Endpoint</div>
                        </ActionColumn>

                        <ActionColumn Title="协议类型">
                            <Tag Class="llm-model-page__tag" Color="@(context.ProtocolType == 0 ? "blue" : "default")">@ProtocolTypeText(context.ProtocolType)</Tag>
                        </ActionColumn>

                        <ActionColumn Title="启用状态">
                            <Tag Class="llm-model-page__tag admin-page__status-tag" Color="@(context.IsEnable ? "green" : "volcano")">@(context.IsEnable ? "启用中" : "已停用")</Tag>
                        </ActionColumn>

                        <PropertyColumn Property="c => (c.UpdateTime ?? c.CreateTime).LocalDateTime" Format="yyyy-MM-dd HH:mm" Title="更新时间"></PropertyColumn>

                        <ActionColumn Title="操作">
                            <Space>
                                <SpaceItem>
                                    <a class="llm-model-page__link admin-page__link" @onclick="() => EditLlmModel(context)">编辑</a>
                                </SpaceItem>

                                <SpaceItem>
                                    <Popconfirm Title="确认要删除吗？"
                                                OnConfirm="_=>DeleteLlmModelAsync(context.Id)"
                                                OkText="Yes"
                                                CancelText="No">
                                        <a class="llm-model-page__link llm-model-page__link--danger admin-page__link admin-page__link--danger">删除</a>
                                    </Popconfirm>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="llm-model-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="@request.PageSize" Current="@request.Page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="760" Visible="isShowEdit" Title='(editId == null ? "新增 LLM 模型" : "编辑 LLM 模型")' OnClose="() => isShowEdit = false">
    <Template>
        <div class="llm-model-drawer admin-drawer">
            <Form Class="llm-model-drawer__form admin-drawer__form admin-form" Model="@editLlmModel" Layout="@FormLayout.Vertical" OnFinish="SaveLlmModelAsync">
                <div class="llm-model-drawer__content">
                    <div class="llm-model-drawer__main">
                        <div class="llm-model-drawer__section admin-drawer__section">
                            <div class="llm-model-drawer__section-head admin-drawer__section-head">
                                <div>
                                    <div class="llm-model-drawer__section-title admin-drawer__section-title">基础配置</div>
                                </div>

                                <div class="llm-model-drawer__switch-box admin-drawer__switch-box">
                                    <span class="llm-model-drawer__switch-label admin-drawer__switch-label">是否启用</span>
                                    <Switch @bind-Value="@editLlmModel.IsEnable" CheckedChildren="是" UnCheckedChildren="否" />
                                </div>
                            </div>

                            <Row Gutter="24">
                                <AntDesign.Col Span="12">
                                    <FormItem Class="llm-model-drawer__field-item admin-form__field-item">
                                        <div class="llm-model-drawer__field-label admin-form__field-label admin-required-label">名称</div>
                                        <Input Placeholder="请输入模型名称" @bind-Value="@context.Name" />
                                    </FormItem>
                                </AntDesign.Col>

                                <AntDesign.Col Span="12">
                                    <FormItem Class="llm-model-drawer__field-item admin-form__field-item">
                                        <div class="llm-model-drawer__field-label admin-form__field-label admin-required-label">模型标识</div>
                                        <Input Placeholder="如: deepseek-v4-flash" @bind-Value="@context.ModelId" />
                                    </FormItem>
                                </AntDesign.Col>
                            </Row>

                            <FormItem Class="llm-model-drawer__field-item admin-form__field-item">
                                <div class="llm-model-drawer__field-label admin-form__field-label admin-required-label">端点地址</div>
                                <Input Placeholder="如: https://api.deepseek.com/chat/completions、https://api.openai.com/v1/responses 或 https://api.anthropic.com/v1/messages" @bind-Value="@context.Endpoint" />
                            </FormItem>

                            <Row Gutter="24">
                                <AntDesign.Col Span="10">
                                    <FormItem Class="llm-model-drawer__field-item admin-form__field-item">
                                        <div class="llm-model-drawer__field-label admin-form__field-label">协议类型</div>
                                        <Select TItem="int" TItemValue="int" @bind-Value="@context.ProtocolType">
                                            <SelectOption Value="0" Label="Chat"></SelectOption>
                                            <SelectOption Value="1" Label="Responses"></SelectOption>
                                            <SelectOption Value="2" Label="Anthropic"></SelectOption>
                                        </Select>
                                    </FormItem>
                                </AntDesign.Col>
                            </Row>

                            <FormItem Class="llm-model-drawer__field-item admin-form__field-item">
                                <div class="llm-model-drawer__field-label admin-form__field-label">接口密钥</div>
                                <InputPassword Placeholder="@(editId == null ? "请输入接口密钥" : "留空则不修改")" @bind-Value="@context.ApiKey" />
                            </FormItem>

                            <FormItem Class="llm-model-drawer__field-item admin-form__field-item">
                                <div class="llm-model-drawer__field-label admin-form__field-label">备注</div>
                                <TextArea @bind-Value="@context.Remark" MinRows="3" MaxRows="7" />
                            </FormItem>
                        </div>
                    </div>
                </div>

                <div class="llm-model-drawer__footer admin-drawer__footer">
                    <Button Class="llm-model-page__action-button llm-model-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Loading="@saveLoading">保存</Button>
                    <Button Class="llm-model-page__action-button llm-model-page__action-button--default admin-page-button admin-page-button--default" Type="@ButtonType.Default" @onclick="() => isShowEdit = false">取消</Button>
                </div>
            </Form>
        </div>
    </Template>
</Drawer>



@code {

    override protected async Task OnParametersSetAsync()
    {
        await GetLlmModelListAsync();
    }

    LlmModelPageRequestDto request = new() { PageSize = 10 };

    bool tableLoading = false;
    PageListDto<LlmModelDto> pageList = new();

    async Task GetLlmModelListAsync()
    {
        tableLoading = true;

        var url = StringHelper.ModelToUriParam(request, "LlmModel/GetLlmModelList");
        var retData = await Http.GetFromJsonAsync<PageListDto<LlmModelDto>>(url, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task HandleSearchAsync(EditContext editContext)
    {
        request.Page = 1;
        await GetLlmModelListAsync();
    }

    async Task HandleReset()
    {
        request = new LlmModelPageRequestDto { PageSize = request.PageSize };
        await GetLlmModelListAsync();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (request.Page != args.Page)
        {
            request.Page = args.Page;
        }

        if (request.PageSize != args.PageSize)
        {
            request.PageSize = args.PageSize;
        }

        await GetLlmModelListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";

    bool isShowEdit = false;
    bool saveLoading = false;
    long? editId;
    EditLlmModelDto editLlmModel = new();

    static string ProtocolTypeText(int protocolType) => protocolType switch
    {
        0 => "Chat",
        1 => "Responses",
        2 => "Anthropic",
        _ => "未知"
    };

    void EditLlmModel(LlmModelDto? row = null)
    {
        if (row == null)
        {
            editId = null;
            editLlmModel = new EditLlmModelDto { IsEnable = true };
        }
        else
        {
            editId = row.Id;
            editLlmModel = new EditLlmModelDto
            {
                Name = row.Name,
                ModelId = row.ModelId,
                Endpoint = row.Endpoint,
                ProtocolType = row.ProtocolType,
                IsEnable = row.IsEnable,
                Remark = row.Remark
            };
        }

        isShowEdit = true;
    }

    async Task SaveLlmModelAsync()
    {
        if (string.IsNullOrWhiteSpace(editLlmModel.Name))
        {
            Message.Error("名称不可以空");
            return;
        }

        if (string.IsNullOrWhiteSpace(editLlmModel.ModelId))
        {
            Message.Error("模型标识不可以空");
            return;
        }

        if (string.IsNullOrWhiteSpace(editLlmModel.Endpoint))
        {
            Message.Error("端点地址不可以空");
            return;
        }

        if (editId == null && string.IsNullOrWhiteSpace(editLlmModel.ApiKey))
        {
            Message.Error("接口密钥不可以空");
            return;
        }

        saveLoading = true;
        try
        {
            using HttpResponseMessage httpResponse = editId == null
                ? await Http.PostAsJsonAsync("LlmModel/CreateLlmModel", editLlmModel, JsonHelper.SerializeOpts)
                : await Http.PostAsJsonAsync("LlmModel/UpdateLlmModel?id=" + editId.Value, editLlmModel, JsonHelper.SerializeOpts);

            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("保存成功");
                isShowEdit = false;
                await GetLlmModelListAsync();
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("保存失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            saveLoading = false;
            StateHasChanged();
        }
    }

    async Task DeleteLlmModelAsync(long id)
    {
        try
        {
            using var httpResponse = await Http.DeleteAsync("LlmModel/DeleteLlmModel?id=" + id);

            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("删除成功");
                await GetLlmModelListAsync();
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("删除失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
    }
}
