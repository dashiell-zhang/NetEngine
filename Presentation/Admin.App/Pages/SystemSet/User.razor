@page "/systemset/user"
@using Application.Model.User.User
@using Application.Model.User.Role
@attribute [ReuseTabsPageTitle("用户管理")]

<div class="system-user-page admin-page">
    <div class="system-user-page__hero admin-page__hero admin-page-hero--with-actions">
        <div>
            <div class="system-user-page__eyebrow admin-page__eyebrow">System Settings</div>
            <h2 class="system-user-page__title admin-page__title">用户管理工作台</h2>
            <div class="system-user-page__subtitle admin-page__subtitle">统一维护账号基础信息、角色归属与权限范围，让新增、检索和授权操作都收敛在同一个页面内完成</div>

            @if (functionList.Contains("user-add"))
            {
                <div class="system-user-page__hero-tools admin-page__hero-tools">
                    <Button Class="system-user-page__action-button system-user-page__action-button--primary admin-page-button admin-page-button--primary admin-page-button--with-plus" Type="@ButtonType.Primary" @onclick="() => EditUser()"><span class="admin-page-button__content"><span class="admin-page-button__icon" aria-hidden="true">+</span><span class="admin-page-button__text">新增用户</span><span class="admin-page-button__spacer" aria-hidden="true"></span></span></Button>
                </div>
            }
        </div>

        <div class="system-user-page__stats admin-page__stats">
            <div class="system-user-page__stat-card admin-page__stat-card">
                <span class="system-user-page__stat-label admin-page__stat-label">用户总量</span>
                <strong class="system-user-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="system-user-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 位用户</span>
            </div>

            <div class="system-user-page__stat-card admin-page__stat-card">
                <span class="system-user-page__stat-label admin-page__stat-label">角色覆盖</span>
                <strong class="system-user-page__stat-value system-user-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@RoleSummaryText()</strong>
                <span class="system-user-page__stat-foot admin-page__stat-foot">已加载 @roleList.Count 个可分配角色</span>
            </div>

            <div class="system-user-page__stat-card admin-page__stat-card">
                <span class="system-user-page__stat-label admin-page__stat-label">检索状态</span>
                <strong class="system-user-page__stat-value system-user-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@KeywordStatusText()</strong>
                <span class="system-user-page__stat-foot admin-page__stat-foot">第 @request.Page 页 / 每页 @request.PageSize 条</span>
            </div>
        </div>
    </div>

    <Card Class="system-user-page__card system-user-page__card--compact admin-page__card admin-page__card--compact admin-page__card--filter">
        <Form Class="system-user-page__filter-form admin-form admin-filter-form" Model="@request" Layout="@FormLayout.Inline" OnFinish="HandleSearchAsync">
            <FormItem Class="system-user-page__filter-item system-user-page__filter-item--keyword admin-filter-form__item--keyword">
                <Input @bind-Value="@context.Keyword" Placeholder="名称 / 用户名 / 电话 / 邮箱 模糊检索" AllowClear />
            </FormItem>

            <FormItem Class="system-user-page__filter-item system-user-page__filter-item--actions admin-filter-form__item--actions">
                <div class="system-user-page__filter-actions admin-filter-form__actions">
                    <Button Class="system-user-page__action-button system-user-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit">搜索用户</Button>
                    <Button Class="system-user-page__action-button system-user-page__action-button--default admin-page-button admin-page-button--default" OnClick="HandleReset">重置条件</Button>
                </div>
            </FormItem>
        </Form>
    </Card>

    <Card Class="system-user-page__card system-user-page__card--compact admin-page__card admin-page__card--compact">
        <div class="system-user-page__list-shell admin-page-list-shell">
            <div class="system-user-page__table-wrap admin-page__table-wrap">
                <Table TItem="UserDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="用户">
                            <div class="system-user-page__user-cell">
                                <div class="system-user-page__user-name" title="@context.Name">@context.Name</div>
                                <div class="system-user-page__user-sub" title="@context.UserName">@context.UserName</div>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="联系方式">
                            <div class="system-user-page__contact-cell">
                                <div class="system-user-page__contact-main" title="@context.Phone">@context.Phone</div>
                                <div class="system-user-page__contact-sub" title="@(string.IsNullOrWhiteSpace(context.Email) ? "未填写邮箱" : context.Email)">@(string.IsNullOrWhiteSpace(context.Email) ? "未填写邮箱" : context.Email)</div>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="角色">
                            <div class="system-user-page__role-pill">@(string.IsNullOrWhiteSpace(context.Roles) ? "未分配角色" : context.Roles)</div>
                        </ActionColumn>

                        <ActionColumn Title="创建时间">
                            <div class="system-user-page__time-cell admin-page__time-cell">@context.CreateTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div>
                        </ActionColumn>

                        <ActionColumn Title="操作">
                            <Space>
                                @if (functionList.Contains("user-edit"))
                                {
                                    <SpaceItem>
                                        <a class="system-user-page__link admin-page__link" @onclick="() => EditUser(context)">编辑</a>
                                    </SpaceItem>
                                }

                                @if (functionList.Contains("user-function"))
                                {
                                    <SpaceItem>
                                        <a class="system-user-page__link system-user-page__link--accent admin-page__link" @onclick="() => EditAuthorityAsync(context)">权限范围</a>
                                    </SpaceItem>
                                }

                                @if (functionList.Contains("user-delete"))
                                {
                                    <SpaceItem>
                                        <Popconfirm Title="确认要删除吗？"
                                                    OnConfirm="_ => DeleteUserAsync(context.Id)"
                                                    OkText="Yes"
                                                    CancelText="No">
                                            <a class="system-user-page__link system-user-page__link--danger admin-page__link admin-page__link--danger">删除</a>
                                        </Popconfirm>
                                    </SpaceItem>
                                }
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="system-user-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="@request.PageSize" Current="@request.Page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="760" Visible="isShowEditUser" Title='(userId == default ? "新增用户" : "编辑用户")' OnClose="() => isShowEditUser = false">
    <Template>
        <div class="system-user-drawer admin-drawer">
            <Form Class="system-user-drawer__form admin-drawer__form admin-form" Model="@editUser" Layout="@FormLayout.Vertical" OnFinish="SaveUserAsync">
                <div class="system-user-drawer__section admin-drawer__section">
                    <div class="system-user-drawer__section-title admin-drawer__section-title">基础资料</div>

                    <Row Gutter="24">
                        <AntDesign.Col Span="12">
                            <FormItem Class="system-user-drawer__field-item admin-form__field-item">
                                <div class="system-user-drawer__field-label admin-form__field-label admin-required-label">名称</div>
                                <Input Placeholder="请输入名称" @bind-Value="@context.Name" AutoComplete="false" />
                            </FormItem>
                        </AntDesign.Col>

                        <AntDesign.Col Span="12">
                            <FormItem Class="system-user-drawer__field-item admin-form__field-item">
                                <div class="system-user-drawer__field-label admin-form__field-label admin-required-label">用户名</div>
                                <Input Placeholder="请输入用户名" @bind-Value="@context.UserName" />
                            </FormItem>
                        </AntDesign.Col>
                    </Row>

                    <Row Gutter="24">
                        <AntDesign.Col Span="12">
                            <FormItem Class="system-user-drawer__field-item admin-form__field-item">
                                <div class="system-user-drawer__field-label admin-form__field-label admin-required-label">手机</div>
                                <Input Placeholder="请输入手机号" Type="InputType.Tel" @bind-Value="@context.Phone" />
                            </FormItem>
                        </AntDesign.Col>

                        <AntDesign.Col Span="12">
                            <FormItem Class="system-user-drawer__field-item admin-form__field-item">
                                <div class="system-user-drawer__field-label admin-form__field-label">邮箱</div>
                                <Input Placeholder="请输入邮箱" Type="InputType.Email" @bind-Value="@context.Email" />
                            </FormItem>
                        </AntDesign.Col>
                    </Row>

                    <FormItem Class="system-user-drawer__field-item admin-form__field-item">
                        <div class="system-user-drawer__field-label admin-form__field-label admin-required-label">密码</div>
                        <InputPassword Placeholder="请输入密码" Type="InputType.Password" @bind-Value="@context.Password" ReadOnly="isReadOnly" OnFocus="() => isReadOnly = false" VisibilityToggle="false" />
                    </FormItem>
                </div>

                <div class="system-user-drawer__section admin-drawer__section">
                    <div class="system-user-drawer__section-head admin-drawer__section-head">
                        <div class="system-user-drawer__section-title admin-drawer__section-title admin-required-label">角色分配</div>
                        <div class="system-user-drawer__section-tip">至少选择一个角色</div>
                    </div>

                    <FormItem Class="system-user-drawer__field-item admin-form__field-item">
                        <CheckboxGroup Class="system-user-drawer__role-group" @bind-Value="@context.RoleIds">
                            <div class="system-user-drawer__role-grid">
                                @foreach (var item in roleList)
                                {
                                    <label class="system-user-drawer__role-card">
                                        <Checkbox Label="@item.Id.ToString()">@item.Name</Checkbox>
                                    </label>
                                }
                            </div>
                        </CheckboxGroup>
                    </FormItem>
                </div>

                <div class="system-user-drawer__footer admin-drawer__footer">
                    <Button Class="system-user-page__action-button system-user-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Loading="@saveLoading">保存用户</Button>
                    <Button Class="system-user-page__action-button system-user-page__action-button--default admin-page-button admin-page-button--default" Type="@ButtonType.Default" @onclick="() => isShowEditUser = false">取消</Button>
                </div>
            </Form>
        </div>
    </Template>
</Drawer>

<Modal Title="权限范围" Width="1160" Visible="@isShowEditAuthority" OnCancel="() => isShowEditAuthority = false" Footer="null" MaxBodyHeight="@("70vh")">
    <div class="system-user-authority admin-authority">
        <div class="system-user-authority__overview admin-authority__overview">
            <div>
                <div class="system-user-authority__eyebrow admin-authority__eyebrow">Authority Scope</div>
                <div class="system-user-authority__title admin-authority__title">@AuthorityUserText()</div>
                <div class="system-user-authority__subtitle admin-authority__subtitle">按菜单模块和功能操作逐项勾选，保存结果会立即同步到当前用户的权限范围</div>
            </div>

            <div class="system-user-authority__meta-pill admin-authority__meta-pill">已加载 @userFunctionList.Count 个顶层模块</div>
        </div>

        <div class="system-user-authority__table-wrap admin-authority-table-shell">
            <Table TItem="UserFunctionDto" DataSource="userFunctionList" TreeChildren="item => item.ChildList" DefaultExpandAllRows HidePagination>

                <Column Title="菜单模块" TData="string">
                    <div class="system-user-authority__menu-cell admin-authority__menu-cell">
                        <Checkbox Label="@context.Id.ToString()" @bind-Value="context.IsCheck" OnChange="isCheck => SetUserFunctionAsync(isCheck, context)">@context.Name</Checkbox>
                    </div>
                </Column>

                <Column Title="功能操作" TData="string">
                    <div class="system-user-authority__action-grid admin-authority__action-grid">
                        @if (context.FunctionList.Count == 0)
                        {
                            <span class="system-user-authority__empty admin-authority__empty">当前模块暂无独立功能项</span>
                        }
                        else
                        {
                            @foreach (var item in context.FunctionList)
                            {
                                <label class="system-user-authority__action-pill admin-authority__action-pill">
                                    <Checkbox Label="@item.Id.ToString()" @bind-Value="item.IsCheck" OnChange="isCheck => SetUserFunctionAsync(isCheck, item)">@item.Name</Checkbox>
                                </label>
                            }
                        }
                    </div>
                </Column>

            </Table>
        </div>
    </div>
</Modal>



@code {

    bool isReadOnly = true;

    List<string> functionList = new();

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();

        var getUserListTask = GetUserListAsync();
        var getRoleSelectTask = GetRoleSelectAsync();

        await Task.WhenAll(getUserListTask, getRoleSelectTask);
    }


    bool saveLoading = false;
    bool tableLoading = false;
    UserPageRequestDto request = new() { PageSize = 10 };
    PageListDto<UserDto> pageList = new();

    bool isShowEditAuthority = false;

    string authorityUserName = string.Empty;

    List<RoleSelectDto> roleList = new();

    List<UserFunctionDto> userFunctionList = new();

    async Task GetRoleSelectAsync()
    {
        var retData = await Http.GetFromJsonAsync<List<RoleSelectDto>>("Role/GetRoleSelect", JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            roleList = retData;
        }
    }

    async Task GetUserListAsync()
    {
        tableLoading = true;

        var url = StringHelper.ModelToUriParam(request, "User/GetUserList");
        var retData = await Http.GetFromJsonAsync<PageListDto<UserDto>>(url, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (request.Page != args.Page)
        {
            request.Page = args.Page;
        }

        if (request.PageSize != args.PageSize)
        {
            request.PageSize = args.PageSize;
        }

        await GetUserListAsync();
    }
    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";


    async Task HandleSearchAsync(EditContext editContext)
    {
        request.Page = 1;
        await GetUserListAsync();
    }

    async Task HandleReset()
    {
        request = new UserPageRequestDto { PageSize = request.PageSize };
        await GetUserListAsync();
    }


    bool isShowEditUser = false;
    EditUserDto editUser = new();
    long userId;

    async Task SaveUserAsync()
    {
        if (editUser.RoleIds.Length == 0)
        {
            Message.Error("至少选择一个角色");
            return;
        }

        saveLoading = true;
        try
        {
            if (userId == default)
            {
                using var httpResponse = await Http.PostAsJsonAsync<EditUserDto>("User/CreateUser", editUser, JsonHelper.SerializeOpts);
                if (httpResponse.IsSuccessStatusCode)
                {
                    Message.Success("添加成功");
                    isShowEditUser = false;
                }
                else if ((int)httpResponse.StatusCode != 400)
                {
                    Message.Error("添加失败");
                }
            }
            else
            {
                using var httpResponse = await Http.PostAsJsonAsync<EditUserDto>("User/UpdateUser?userId=" + userId, editUser, JsonHelper.SerializeOpts);
                if (httpResponse.IsSuccessStatusCode)
                {
                    Message.Success("编辑成功");

                    isShowEditUser = false;
                }
                else if ((int)httpResponse.StatusCode != 400)
                {
                    Message.Error("编辑失败");
                }
            }

            if (!isShowEditUser)
            {
                await GetUserListAsync();
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            saveLoading = false;
            StateHasChanged();
        }
    }


    void EditUser(UserDto? user = null)
    {
        editUser = new EditUserDto();
        userId = default;
        isReadOnly = true;
        if (user != null)
        {
            userId = user.Id;
            editUser.Name = user.Name;
            editUser.UserName = user.UserName;
            editUser.Phone = user.Phone;
            editUser.Email = user.Email;
            editUser.Password = "default";
            if (user.RoleIds != null)
            {
                editUser.RoleIds = user.RoleIds;
            }
        }

        isShowEditUser = true;

        StateHasChanged();
    }



    async Task DeleteUserAsync(long userId)
    {
        try
        {
            using var httpResponse = await Http.DeleteAsync("User/DeleteUser?id=" + userId);
            if (httpResponse.IsSuccessStatusCode)
            {
                await GetUserListAsync();
                Message.Success("删除成功");
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("删除失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
    }


    async Task EditAuthorityAsync(UserDto user)
    {
        userId = user.Id;
        authorityUserName = string.IsNullOrWhiteSpace(user.Name) ? user.UserName : user.Name;

        var retData = await Http.GetFromJsonAsync<List<UserFunctionDto>>("User/GetUserFunction?userId=" + userId, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            userFunctionList = retData;
        }

        isShowEditAuthority = true;

        StateHasChanged();
    }


    async Task SetUserFunctionAsync(bool isCheck, UserFunctionDto userFunction)
    {
        SetUserFunctionDto setUserFunction = new()
        {
            UserId = userId,
            FunctionId = userFunction.Id,
            IsCheck = isCheck
        };

        try
        {
            using var httpResponse = await Http.PostAsJsonAsync<SetUserFunctionDto>("User/SetUserFunction", setUserFunction, JsonHelper.SerializeOpts);
            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("设置成功");
            }
            else
            {
                userFunction.IsCheck = !isCheck;
                if ((int)httpResponse.StatusCode != 400)
                {
                    Message.Error("设置失败");
                }
            }
        }
        catch (HttpRequestException)
        {
            userFunction.IsCheck = !isCheck;
            Message.Error("请求失败，请稍后重试");
        }

        StateHasChanged();
    }


    /// <summary>
    /// 获取当前关键字筛选描述
    /// </summary>
    string KeywordStatusText()
    {
        return string.IsNullOrWhiteSpace(request.Keyword) ? "全部用户" : "关键词检索中";
    }


    /// <summary>
    /// 获取角色覆盖摘要
    /// </summary>
    string RoleSummaryText()
    {
        return roleList.Count == 0 ? "角色加载中" : $"{roleList.Count} 个角色";
    }


    /// <summary>
    /// 获取权限配置标题
    /// </summary>
    string AuthorityUserText()
    {
        return string.IsNullOrWhiteSpace(authorityUserName) ? "当前用户权限范围" : $"{authorityUserName} 的权限范围";
    }

}
