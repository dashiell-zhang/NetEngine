@page "/information/article"
@using Application.Model.Site.Article
@inject ImageUploadService imageUploadService
@attribute [ReuseTabsPageTitle("文章管理")]

<div class="article-page admin-page">
    <div class="article-page__hero admin-page__hero admin-page__hero--with-actions">
        <div>
            <div class="article-page__eyebrow admin-page__eyebrow">Information Management</div>
            <h2 class="article-page__title admin-page__title">文章管理工作台</h2>
            <div class="article-page__subtitle admin-page__subtitle">统一管理文章标题、栏目归属、推荐与显示状态，让内容发布、编辑和维护都在一个视图内快速完成</div>

            @if (functionList.Contains("article-add"))
            {
                <div class="article-page__hero-tools admin-page__hero-tools">
                    <Button Class="article-page__action-button article-page__action-button--primary admin-page-button admin-page-button--primary admin-page-button--with-plus" Type="@ButtonType.Primary" OnClick="() => EditArticleAsync()"><span class="admin-page-button__content"><span class="admin-page-button__icon" aria-hidden="true">+</span><span class="admin-page-button__text">添加文章</span><span class="admin-page-button__spacer" aria-hidden="true"></span></span></Button>
                </div>
            }
        </div>

        <div class="article-page__stats admin-page__stats">
            <div class="article-page__stat-card admin-page__stat-card">
                <span class="article-page__stat-label admin-page__stat-label">文章总量</span>
                <strong class="article-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="article-page__stat-foot admin-page__stat-foot">当前页加载 @(pageList.List?.Count ?? 0) 篇文章</span>
            </div>

            <div class="article-page__stat-card admin-page__stat-card">
                <span class="article-page__stat-label admin-page__stat-label">当前页推荐</span>
                <strong class="article-page__stat-value admin-page__stat-value">@RecommendArticleCount()</strong>
                <span class="article-page__stat-foot admin-page__stat-foot">推荐内容可在首页或重点区位优先展示</span>
            </div>

            <div class="article-page__stat-card admin-page__stat-card">
                <span class="article-page__stat-label admin-page__stat-label">当前页显示中</span>
                <strong class="article-page__stat-value article-page__stat-value--small admin-page__stat-value">@DisplayArticleCount()</strong>
                <span class="article-page__stat-foot admin-page__stat-foot">已显示文章会在前台内容列表中对外可见</span>
            </div>
        </div>
    </div>

    <Card Class="article-page__card article-page__card--compact admin-page__card admin-page__card--compact">
        <div class="article-page__list-shell admin-page-list-shell">
            <div class="article-page__table-wrap admin-page__table-wrap">
                <Table TItem="ArticleDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="标题">
                            <div class="article-page__title-cell">
                                <div class="article-page__title-main" title="@context.Title">@context.Title</div>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="类别">
                            <div class="article-page__category-pill" title="@CategoryText(context)">@CategoryText(context)</div>
                        </ActionColumn>

                        <ActionColumn Title="推荐状态">
                            <div class="article-page__state-badge @(context.IsRecommend ? "article-page__state-badge--blue" : "article-page__state-badge--plain")">@RecommendStatusText(context)</div>
                        </ActionColumn>

                        <ActionColumn Title="显示状态">
                            <div class="article-page__state-badge @(context.IsDisplay ? "article-page__state-badge--green" : "article-page__state-badge--warn")">@DisplayStatusText(context)</div>
                        </ActionColumn>

                        <ActionColumn Title="点击量">
                            <div class="article-page__click-pill">@context.ClickCount</div>
                        </ActionColumn>

                        <ActionColumn Title="创建时间">
                            <div class="article-page__time-cell admin-page__time-cell">@context.CreateTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div>
                        </ActionColumn>

                        <ActionColumn Title="操作">
                            <Space>

                                @if (functionList.Contains("article-edit"))
                                {
                                    <SpaceItem>
                                        <a class="article-page__link-action admin-page__link-action" @onclick="() => EditArticleAsync(context)">编辑</a>
                                    </SpaceItem>
                                }

                                @if (functionList.Contains("article-delete"))
                                {
                                    <SpaceItem>
                                        <Popconfirm Title="确认要删除吗？"
                                                    OnConfirm="_=>DeleteArticleAsync(context.Id)"
                                                    OkText="Yes"
                                                    CancelText="No">
                                            <a class="article-page__link-action article-page__link-action--danger admin-page__link-action admin-page__link-action--danger">删除</a>
                                        </Popconfirm>

                                    </SpaceItem>
                                }

                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="article-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="pageSize" Current="page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


@{
    RenderFragment editFooter = @<Template>
        <div class="article-editor__footer-actions">
            <Button Class="article-page__action-button article-page__action-button--primary admin-page-button admin-page-button--primary" OnClick="SaveArticleAsync" Type="@ButtonType.Primary" Loading="@saveLoading">保存文章</Button>
            <Button Class="article-page__action-button article-page__action-button--default admin-page-button admin-page-button--default" OnClick="CloseArticleEditorAsync" @key="@("back")">取消</Button>
        </div>
    </Template>;
}


<Modal Title='@(articleId == default ? "新增文章" : "编辑文章")' Width="1520" MaxBodyHeight="@("calc(100vh - 150px)")" Visible="@isShowEditArticle" Class="article-editor-modal admin-content-editor-modal" Centered="true" Maximizable="true" OnCancel="CloseArticleEditorAsync" Footer="@editFooter">

    <div class="article-editor admin-content-editor">
    <Form @ref="@_editArticleForm" Model="@editArticle" Layout="@FormLayout.Vertical" Class="ueditorBody article-editor__form admin-content-editor__form admin-form">
        <div class="article-editor__workspace admin-content-editor__workspace">
            <div class="article-editor__main-column admin-content-editor__main">
                <div class="article-editor__panel admin-content-editor__main-panel">
                    <div class="article-editor__panel-title">基础资料</div>

                    <div class="article-editor__info-grid admin-form__field-grid">
                        <FormItem Label="所属栏目" Class="article-editor__field-item">
                            <TreeSelect TItem="TreeSelectDto" TItemValue="string" DataSource="selectCategoryList" @bind-Value="@context.CategoryId" Placeholder="请选择所属栏目" TreeDefaultExpandAll ChildrenExpression="node => node.DataItem.Children" DisabledExpression="node => node.DataItem.IsDisabled" TitleExpression="node => node.DataItem.Title" KeyExpression="node => node.DataItem.Key" IsLeafExpression="node => node.DataItem.Children == null"></TreeSelect>
                        </FormItem>

                        <FormItem Label="标题" Class="article-editor__field-item article-editor__field-item--wide">
                            <Input Placeholder="请输入标题" @bind-Value="@context.Title" />
                        </FormItem>
                    </div>

                    <FormItem Label="内容" Class="article-editor__field-item article-editor__content-item admin-content-editor__content-item">
                        <TextArea Id="Content" @bind-Value="@context.Content" />
                    </FormItem>
                </div>
            </div>

            <div class="article-editor__side-column admin-content-editor__side">
                <div class="article-editor__settings-card article-editor__panel">
                    <div class="article-editor__panel-title">发布设置</div>

                    <div class="article-editor__toggle-stack">
                        <div class="article-editor__toggle-card">
                            <div class="article-editor__toggle-copy">
                                <span class="article-editor__toggle-title">是否显示</span>
                            </div>
                            <Switch @bind-Value="@context.IsDisplay" CheckedChildren="是" UnCheckedChildren="否" />
                        </div>

                        <div class="article-editor__toggle-card">
                            <div class="article-editor__toggle-copy">
                                <span class="article-editor__toggle-title">是否推荐</span>
                            </div>
                            <Switch @bind-Value="@context.IsRecommend" CheckedChildren="是" UnCheckedChildren="否" />
                        </div>
                    </div>

                    <div class="article-editor__mini-grid admin-form__field-grid">
                        <FormItem Label="排序" Class="article-editor__field-item">
                            <Input Placeholder="请输入排序值" Type="InputType.Number" @bind-Value="@context.Sort" />
                        </FormItem>

                        <FormItem Label="点击量" Class="article-editor__field-item">
                            <Input Placeholder="请输入点击量" Type="InputType.Number" @bind-Value="@context.ClickCount" />
                        </FormItem>
                    </div>
                </div>

                <div class="article-editor__panel article-editor__cover-panel">
                    <div class="article-editor__panel-title">摘要与封面</div>

                    <FormItem Label="摘要" Class="article-editor__field-item article-editor__summary-item">
                        <div class="article-editor__summary-field">
                            <TextArea Class="article-editor__summary-input" BindOnInput="true" MaxLength=255 Placeholder="不填写则自动截取内容前255字符" @bind-Value="@context.Digest" MinRows="3" MaxRows="4" />
                            <div class="article-editor__summary-count">@(context.Digest?.Length ?? 0) / 255</div>
                        </div>
                    </FormItem>

                    <FormItem Class="article-editor__field-item article-editor__upload-item">
                        <InputFile id="fileInput" OnChange="@UploadImgageAsync" hidden multiple accept=".png,.jpg" />
                        <Upload Name="files">
                            <label class="ant-btn article-editor__upload-trigger" for="fileInput">
                                <Icon Type="upload" />
                                上传图片
                            </label>
                        </Upload>

                        <Upload Class="article-editor__upload-list" FileList="fileList" ListType="UploadListType.PictureCard" OnPreview="(file) => PreviewImg(file)" OnRemove=" (file)=> DeleteImgAsync(file)" ShowButton=false></Upload>

                        <Image Class="article-editor__preview-image" PreviewSrc="@previewImgUrl" @bind-PreviewVisible="isPreviewImg" />
                    </FormItem>
                </div>
            </div>
        </div>

    </Form>
</div>
</Modal>




@code {

    /// <summary>
    /// 上传文章封面图片
    /// </summary>
    /// <param name="e">文件选择事件参数</param>
    async Task UploadImgageAsync(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            try
            {
                var uploadResult = await imageUploadService.UploadImageAsync(file, new ImageUploadRequest
                {
                    Business = "Article",
                    Key = uploadKey,
                    Sign = "cover",
                    IsPublicRead = true
                });
                string fileUrl = await JS.InvokeAsync<string>("CreateObjectUrl", uploadResult.FileBytes, uploadResult.ContentType);

                fileList.Add(new UploadFileItem()
                {
                    Id = uploadResult.FileId,
                    FileName = uploadResult.FileName,
                    Url = fileUrl,
                    State = UploadState.Success
                });
            }
            catch (Exception ex)
            {
                Message.Error(file.Name + " 上传失败 " + ex.Message);
            }

            StateHasChanged();
        }

    }


    private Form<EditArticleDto>? _editArticleForm;

    bool isPreviewImg = false;
    string? previewImgUrl;
    long uploadKey;
    bool saveLoading = false;
    List<UploadFileItem> fileList = new();

    List<TreeSelectDto>? selectCategoryList;


    List<string> functionList = new();

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();
    }

    override protected async Task OnParametersSetAsync()
    {
        var getArticleListTask = GetArticleListAsync();
        var getCategorySelectListTask = GetCategorySelectListAsync();

        await Task.WhenAll(getArticleListTask, getCategorySelectListTask);
    }



    async Task GetCategorySelectListAsync()
    {
        List<CategorySelectDto> parentKVList = new();

        var kvList = await Http.GetFromJsonAsync<List<CategorySelectDto>>("Article/GetCategorySelectList", JsonHelper.DeserializeOpts);

        if (kvList != null)
        {
            parentKVList.AddRange(kvList);

            selectCategoryList = CategoryTreeConvert(parentKVList)!.ToList();
        }

    }

    private IEnumerable<TreeSelectDto>? CategoryTreeConvert(List<CategorySelectDto>? keyValueChildren)
    {
        return keyValueChildren?.Select(t => new TreeSelectDto
        {
            Key = t.Id.ToString()!,
            Title = t.Name!.ToString()!,
            Children = CategoryTreeConvert(t.ChildList),
            IsDisabled = false
        }).ToList();
    }

    bool tableLoading = false;
    int page = 1;
    int pageSize = 10;
    PageListDto<ArticleDto> pageList = new();

    async Task GetArticleListAsync()
    {
        tableLoading = true;
        var retData = await Http.GetFromJsonAsync<PageListDto<ArticleDto>>("Article/GetArticleList?page=" + page + "&pageSize=" + pageSize, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (page != args.Page)
        {
            page = args.Page;
        }

        if (pageSize != args.PageSize)
        {
            pageSize = args.PageSize;
        }

        await GetArticleListAsync();
    }
    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";


    /// <summary>
    /// 获取当前页推荐文章数量
    /// </summary>
    int RecommendArticleCount()
    {
        return pageList.List?.Count(item => item.IsRecommend) ?? 0;
    }


    /// <summary>
    /// 获取当前页显示中的文章数量
    /// </summary>
    int DisplayArticleCount()
    {
        return pageList.List?.Count(item => item.IsDisplay) ?? 0;
    }

    /// <summary>
    /// 获取栏目显示文本
    /// </summary>
    string CategoryText(ArticleDto article)
    {
        return string.IsNullOrWhiteSpace(article.CategoryName) ? "未分配栏目" : article.CategoryName;
    }


    /// <summary>
    /// 获取推荐状态显示文本
    /// </summary>
    string RecommendStatusText(ArticleDto article)
    {
        return article.IsRecommend ? "已推荐" : "普通文章";
    }


    /// <summary>
    /// 获取显示状态文本
    /// </summary>
    string DisplayStatusText(ArticleDto article)
    {
        return article.IsDisplay ? "显示中" : "已隐藏";
    }


    bool isShowEditArticle = false;
    EditArticleDto editArticle = new();
    long articleId;


    /// <summary>
    /// 打开文章新增或编辑窗口
    /// </summary>
    /// <param name="article">待编辑文章</param>
    async Task EditArticleAsync(ArticleDto? article = null)
    {

        editArticle = new();

        foreach (var item in fileList)
        {
            if (item.Url.StartsWith("blob"))
            {
                JS.InvokeAsync<string>("RevokeObjectUrl", item.Url);
            }
        }

        fileList = new();
        articleId = default;
        uploadKey = await Http.GetFromJsonAsync<long>("Base/GetSnowflakeId", JsonHelper.DeserializeOpts);

        if (article != null)
        {
            articleId = article.Id;
            editArticle.CategoryId = article.CategoryId.ToString();

            editArticle.Title = article.Title;
            editArticle.Sort = article.Sort;
            editArticle.ClickCount = article.ClickCount;
            editArticle.Digest = article.Digest;
            editArticle.Content = article.Content;
            editArticle.IsDisplay = article.IsDisplay;
            editArticle.IsRecommend = article.IsRecommend;

            if (article.CoverImageList != null && article.CoverImageList.Any())
            {
                fileList = article.CoverImageList?.Select(t => new UploadFileItem
                {
                    Id = t.Id.ToString(),
                    FileName = "coverImg.jpg",
                    Url = t.Url,
                    State = UploadState.Success
                }).ToList()!;
            }

        }
        else
        {
            editArticle.IsDisplay = true;
            editArticle.Sort = 99;
            editArticle.CategoryId = "";
        }

        var getCategorySelectListTask = GetCategorySelectListAsync();

        isShowEditArticle = true;

        StateHasChanged();

        await Task.WhenAll(getCategorySelectListTask, Task.Delay(200));

        if (!isShowEditArticle)
        {
            return;
        }

        await JS.InvokeVoidAsync("InitUeditor", "Content", 370, null, uploadKey.ToString());

    }


    /// <summary>
    /// 保存文章信息并绑定本次上传批次
    /// </summary>
    async Task SaveArticleAsync()
    {
        editArticle.Content = await JS.InvokeAsync<string>("GetUeditorContent", "Content");
        var contentFileIdList = await JS.InvokeAsync<List<string>>("GetUeditorFileIds", "Content");
        editArticle.ContentFileIdList = contentFileIdList.Select(t => long.TryParse(t, out var fileId) ? fileId : default).Where(t => t > 0).Distinct().ToList();

        if (_editArticleForm!.Validate())
        {

            saveLoading = true;
            try
            {
                if (articleId == default)
                {
                    using var httpResponse = await Http.PostAsJsonAsync<EditArticleDto>("Article/CreateArticle?uploadKey=" + uploadKey, editArticle, JsonHelper.SerializeOpts);

                    if (httpResponse.IsSuccessStatusCode)
                    {
                        Message.Success("添加成功");
                        await CloseArticleEditorAsync();
                        await GetArticleListAsync();
                    }
                    else if ((int)httpResponse.StatusCode != 400)
                    {
                        Message.Error("添加失败");
                    }
                }
                else
                {
                    using var httpResponse = await Http.PostAsJsonAsync<EditArticleDto>("Article/UpdateArticle?articleId=" + articleId + "&uploadKey=" + uploadKey, editArticle, JsonHelper.SerializeOpts);
                    if (httpResponse.IsSuccessStatusCode)
                    {
                        Message.Success("编辑成功");
                        await CloseArticleEditorAsync();
                        await GetArticleListAsync();
                    }
                    else if ((int)httpResponse.StatusCode != 400)
                    {
                        Message.Error("编辑失败");
                    }
                }
            }
            catch (HttpRequestException)
            {
                Message.Error("请求失败，请稍后重试");
            }
            finally
            {
                saveLoading = false;
                StateHasChanged();
            }
        }
    }


    /// <summary>
    /// 关闭文章编辑窗口并释放富文本编辑器实例
    /// </summary>
    async Task CloseArticleEditorAsync()
    {

        try
        {
            await JS.InvokeVoidAsync("DestroyUeditor", "Content");
        }
        finally
        {
            isShowEditArticle = false;
        }

    }


    async Task DeleteArticleAsync(long articleId)
    {
        try
        {
            using var httpResponse = await Http.DeleteAsync("Article/DeleteArticle?id=" + articleId);
            if (httpResponse.IsSuccessStatusCode)
            {
                await GetArticleListAsync();
                Message.Success("删除成功");
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("删除失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
    }


    void PreviewImg(UploadFileItem file)
    {
        isPreviewImg = true;
        previewImgUrl = file.Url;
    }

    async Task<bool> DeleteImgAsync(UploadFileItem file)
    {
        try
        {
            using var httpResponse = await Http.DeleteAsync("File/DeleteFile?id=" + file.Id);

            if (httpResponse.IsSuccessStatusCode)
            {
                var retValue = await httpResponse.Content.ReadAsStringAsync();

                if (Convert.ToBoolean(retValue))
                {
                    fileList.Remove(file);

                    return true;
                }
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("删除图片失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }

        return false;
    }

}
