@page "/operations/llmapp"
@using Application.Model.LLM.LlmApp
@using Application.Model.LLM.LlmModel
@using System.Net.Http.Json
@attribute [ReuseTabsPageTitle("LLM应用")]

<div class="llm-app-page admin-page">
    <div class="llm-app-page__hero admin-page__hero admin-page-hero--with-actions">
        <div>
            <div class="llm-app-page__eyebrow admin-page__eyebrow">Operations</div>
            <h2 class="llm-app-page__title admin-page__title">LLM 应用编排台</h2>
            <div class="llm-app-page__subtitle admin-page__subtitle">集中维护应用入口、提示词模板和调试参数，让模型配置、应用配置与联调过程保持在同一视图内完成</div>

            <div class="llm-app-page__hero-tools admin-page__hero-tools">
                <Button Class="llm-app-page__hero-button admin-page-button admin-page-button--primary admin-page-button--with-plus" Type="@ButtonType.Primary" @onclick="() => EditLlmApp()"><span class="admin-page-button__content"><span class="admin-page-button__icon" aria-hidden="true">+</span><span class="admin-page-button__text">新增应用</span><span class="admin-page-button__spacer" aria-hidden="true"></span></span></Button>
            </div>
        </div>

        <div class="llm-app-page__stats admin-page__stats">
            <div class="llm-app-page__stat-card admin-page__stat-card">
                <span class="llm-app-page__stat-label admin-page__stat-label">应用总量</span>
                <strong class="llm-app-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="llm-app-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 条记录</span>
            </div>

            <div class="llm-app-page__stat-card admin-page__stat-card">
                <span class="llm-app-page__stat-label admin-page__stat-label">启用筛选</span>
                <strong class="llm-app-page__stat-value llm-app-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@(request.IsEnable == null ? "全部应用" : request.IsEnable.Value ? "仅启用" : "仅停用")</strong>
                <span class="llm-app-page__stat-foot admin-page__stat-foot">快速聚焦可发布或已停用配置</span>
            </div>

            <div class="llm-app-page__stat-card admin-page__stat-card">
                <span class="llm-app-page__stat-label admin-page__stat-label">检索状态</span>
                <strong class="llm-app-page__stat-value llm-app-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@(string.IsNullOrWhiteSpace(request.Keyword) ? "全部应用" : "关键词检索")</strong>
                <span class="llm-app-page__stat-foot admin-page__stat-foot">第 @request.Page 页 / 每页 @request.PageSize 条</span>
            </div>
        </div>
    </div>

    <Card Class="llm-app-page__card llm-app-page__card--compact admin-page__card admin-page__card--compact admin-page__card--filter">
        <Form Class="llm-app-page__filter-form llm-app-page__filter-form--inline admin-form admin-filter-form" Model="@request" Layout="@FormLayout.Inline" OnFinish="HandleSearchAsync">
            <FormItem Class="llm-app-page__filter-item llm-app-page__filter-item--keyword admin-filter-form__item--keyword">
                <Input @bind-Value="@context.Keyword" Placeholder="Code / 名称 / 备注 模糊检索" AllowClear />
            </FormItem>

            <FormItem Class="llm-app-page__filter-item llm-app-page__filter-item--status admin-filter-form__item--status">
                <Select TItem="bool?" TItemValue="bool?" @bind-Value="@context.IsEnable" Placeholder="请选择状态" AllowClear>
                    <SelectOption Value="@((bool?)true)" Label="启用"></SelectOption>
                    <SelectOption Value="@((bool?)false)" Label="停用"></SelectOption>
                </Select>
            </FormItem>

            <FormItem Class="llm-app-page__filter-item llm-app-page__filter-item--actions admin-filter-form__item--actions">
                <div class="llm-app-page__filter-actions admin-filter-form__actions">
                    <Button Class="llm-app-page__action-button llm-app-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit">搜索应用</Button>
                    <Button Class="llm-app-page__action-button llm-app-page__action-button--default admin-page-button admin-page-button--default" OnClick="HandleReset">重置条件</Button>
                </div>
            </FormItem>
        </Form>
    </Card>

    <Card Class="llm-app-page__card llm-app-page__card--compact admin-page__card admin-page__card--compact">
        <div class="llm-app-page__list-shell admin-page-list-shell">
            <div class="llm-app-page__table-wrap admin-page__table-wrap">
                <Table TItem="LlmAppDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="应用">
                            <div class="llm-app-page__app-cell">
                                <div class="llm-app-page__app-code">@context.Code</div>
                                <div class="llm-app-page__app-name">@context.Name</div>
                            </div>
                        </ActionColumn>
                        <PropertyColumn Property="c => c.LlmModelName" Title="模型"></PropertyColumn>
                        <ActionColumn Title="状态">
                            <Tag Class="llm-app-page__status-tag admin-page__status-tag" Color="@EnableStatusColor(context.IsEnable)">@EnableStatusText(context.IsEnable)</Tag>
                        </ActionColumn>
                        <PropertyColumn Property="c => (c.UpdateTime ?? c.CreateTime).LocalDateTime" Format="yyyy-MM-dd HH:mm" Title="更新时间"></PropertyColumn>
                        <ActionColumn Title="操作">
                            <Space>
                                <SpaceItem>
                                    <a class="llm-app-page__link admin-page__link" @onclick="() => EditLlmApp(context)">编辑</a>
                                </SpaceItem>

                                <SpaceItem>
                                    <Popconfirm Title="确认要删除吗？"
                                                OnConfirm="_=>DeleteLlmAppAsync(context.Id)"
                                                OkText="Yes"
                                                CancelText="No">
                                        <a class="llm-app-page__link llm-app-page__link--danger admin-page__link admin-page__link--danger">删除</a>
                                    </Popconfirm>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="llm-app-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="@request.PageSize" Current="@request.Page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="1480" Visible="isShowEdit" Title='(editId == null ? "新增 LLM 应用" : "编辑 LLM 应用")' OnClose="() => isShowEdit = false">
    <Template>
        <div class="llm-app-drawer admin-drawer">
            <Form Class="llm-app-drawer__form admin-drawer__form admin-form" Model="@editLlmApp" Layout="@FormLayout.Vertical" OnFinish="SaveLlmAppAsync">
                <div class="llm-app-drawer__content">
                    <div class="llm-app-drawer__main">
                        <div class="llm-app-drawer__section admin-drawer__section">
                            <div class="llm-app-drawer__section-head admin-drawer__section-head">
                                <div>
                                    <div class="llm-app-drawer__section-title admin-drawer__section-title">基本配置</div>
                                </div>

                                <div class="llm-app-drawer__switch-box admin-drawer__switch-box">
                                    <span class="llm-app-drawer__switch-label admin-drawer__switch-label">是否启用</span>
                                    <Switch @bind-Value="@editLlmApp.IsEnable" CheckedChildren="是" UnCheckedChildren="否" />
                                </div>
                            </div>

                            <Row Gutter="24">
                                <AntDesign.Col Span="12">
                                    <FormItem Class="llm-app-drawer__field-item admin-form__field-item">
                                        <div class="llm-app-drawer__field-label admin-form__field-label admin-required-label">Code</div>
                                        <Input Placeholder="如: deepseek-chat-default" @bind-Value="@context.Code" />
                                    </FormItem>
                                </AntDesign.Col>

                                <AntDesign.Col Span="12">
                                    <FormItem Class="llm-app-drawer__field-item admin-form__field-item">
                                        <div class="llm-app-drawer__field-label admin-form__field-label admin-required-label">名称</div>
                                        <Input Placeholder="请输入名称" @bind-Value="@context.Name" />
                                    </FormItem>
                                </AntDesign.Col>
                            </Row>

                            <Row Gutter="24">
                                <AntDesign.Col Span="24">
                                    <FormItem Class="llm-app-drawer__field-item admin-form__field-item">
                                        <div class="llm-app-drawer__field-label admin-form__field-label admin-required-label">模型</div>
                                        <Select TItem="LlmModelSelectDto" TItemValue="long"
                                                DataSource="@modelSelectList"
                                                @bind-Value="@context.LlmModelId"
                                                ValueName="@nameof(LlmModelSelectDto.Id)"
                                                LabelName="@nameof(LlmModelSelectDto.Name)"
                                                Placeholder="请选择模型" />
                                    </FormItem>
                                </AntDesign.Col>
                            </Row>

                            <FormItem Class="llm-app-drawer__textarea-item admin-form__field-item">
                                <div class="llm-app-drawer__field-label admin-form__field-label">ExtraBodyJson</div>
                                <TextArea @bind-Value="@context.ExtraBodyJson"
                                          Placeholder='JSON对象，直接透传到请求body根字段，如 {"enable_thinking":true}'
                                          MinRows="4"
                                          MaxRows="10" />
                            </FormItem>

                            <FormItem Class="llm-app-drawer__textarea-item admin-form__field-item">
                                <div class="llm-app-drawer__field-label admin-form__field-label">备注</div>
                                <TextArea @bind-Value="@context.Remark" MinRows="2" MaxRows="6" />
                            </FormItem>

                            <FormItem Class="llm-app-drawer__textarea-item admin-form__field-item">
                                <div class="llm-app-drawer__field-label admin-form__field-label">SystemPromptTemplate</div>
                                <TextArea @bind-Value="@context.SystemPromptTemplate" MinRows="6" MaxRows="16" />
                            </FormItem>

                            <FormItem Class="llm-app-drawer__textarea-item admin-form__field-item">
                                <div class="llm-app-drawer__field-label admin-form__field-label admin-required-label">PromptTemplate</div>
                                <TextArea @bind-Value="@context.PromptTemplate" MinRows="6" MaxRows="16" />
                            </FormItem>
                        </div>
                    </div>

                    <div class="llm-app-drawer__side">
                        <div class="llm-app-drawer__section llm-app-drawer__section--sandbox admin-drawer__section admin-drawer__section--accent">
                            <div class="llm-app-drawer__section-head admin-drawer__section-head">
                                <div>
                                    <div class="llm-app-drawer__section-title admin-drawer__section-title">调用测试</div>
                                    <div class="llm-app-drawer__section-desc admin-drawer__section-desc">识别模板中的占位符并现场填写测试参数，直接验证返回内容是否符合预期</div>
                                </div>
                            </div>

                            @if (PlaceholderInfos.Count != 0)
                            {
                                <div class="llm-app-drawer__placeholder-summary">
                                    检测到占位符：@string.Join("、", PlaceholderInfos.Select(t => t.Display))
                                </div>

                                <Row Gutter="24" class="llm-app-drawer__param-grid">
                                    @foreach (var p in PlaceholderInfos)
                                    {
                                        var paramItem = GetOrCreateTestParamItem(p.Key);
                                        <AntDesign.Col Span="12">
                                            <div class="llm-app-drawer__param-card">
                                                <FormItem>
                                                    <div class="llm-app-drawer__field-label admin-form__field-label">
                                                        @p.Key
                                                        @if (!string.IsNullOrWhiteSpace(p.Comment))
                                                        {
                                                            <span class="llm-app-drawer__field-comment">@p.Comment</span>
                                                        }
                                                        @if (p.IsRequired)
                                                        {
                                                            <span class="llm-app-drawer__required">*</span>
                                                        }
                                                    </div>
                                                    <Input @bind-Value="@paramItem.Value" Placeholder="@(string.IsNullOrWhiteSpace(p.Comment) ? $"请输入 {p.Key}" : $"请输入 {p.Comment}")" />
                                                </FormItem>
                                            </div>
                                        </AntDesign.Col>
                                    }
                                </Row>
                            }
                            else
                            {
                                <div class="llm-app-drawer__placeholder-summary llm-app-drawer__placeholder-summary--empty">
                                    未检测到 {{key}} / {{*key}} / {{*key|变量注释}} 占位符
                                </div>
                            }

                            <div class="llm-app-drawer__test-bar">
                                <Button Class="llm-app-page__action-button llm-app-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" Loading="@testLoading" @onclick="TestCallAsync">调用测试</Button>

                                <div class="llm-app-drawer__test-meta">
                                    @if (!string.IsNullOrWhiteSpace(testResult?.Model))
                                    {
                                        <span class="llm-app-drawer__meta-pill llm-app-drawer__meta-pill--soft">Model: @testResult!.Model</span>
                                    }
                                    @if (testResult?.Usage?.TotalTokens != null)
                                    {
                                        <span class="llm-app-drawer__meta-pill llm-app-drawer__meta-pill--soft">Tokens: @testResult.Usage.TotalTokens</span>
                                    }
                                </div>
                            </div>

                            <div class="llm-app-drawer__result-box">
                                <div class="llm-app-drawer__result-toolbar">
                                    <span class="llm-app-drawer__result-dot"></span>
                                    <span class="llm-app-drawer__result-dot"></span>
                                    <span class="llm-app-drawer__result-dot"></span>
                                    <span class="llm-app-drawer__result-caption">返回结果</span>
                                </div>

                                <TextArea Value="@testResult?.Content" ReadOnly MinRows="6" MaxRows="18" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="llm-app-drawer__footer admin-drawer__footer">
                    <Button Class="llm-app-page__action-button llm-app-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Loading="@saveLoading">保存</Button>
                    <Button Class="llm-app-page__action-button llm-app-page__action-button--default admin-page-button admin-page-button--default" Type="@ButtonType.Default" @onclick="() => isShowEdit = false">取消</Button>
                </div>
            </Form>
        </div>
    </Template>
</Drawer>



@code {

    List<string> functionList = new();

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();
    }

    override protected async Task OnParametersSetAsync()
    {
        await GetLlmAppListAsync();
    }

    LlmAppPageRequestDto request = new() { PageSize = 10 };

    bool tableLoading = false;
    PageListDto<LlmAppDto> pageList = new();

    List<LlmModelSelectDto> modelSelectList = [];

    async Task GetLlmAppListAsync()
    {
        tableLoading = true;

        var url = StringHelper.ModelToUriParam(request, "Operations/GetLlmAppList");
        var retData = await Http.GetFromJsonAsync<PageListDto<LlmAppDto>>(url, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task GetModelSelectListAsync()
    {
        var retData = await Http.GetFromJsonAsync<List<LlmModelSelectDto>>("LlmModel/GetLlmModelSelect", JsonHelper.DeserializeOpts);
        if (retData != null)
        {
            modelSelectList = retData;
        }
    }

    async Task HandleSearchAsync(EditContext editContext)
    {
        request.Page = 1;
        await GetLlmAppListAsync();
    }

    async Task HandleReset()
    {
        request = new LlmAppPageRequestDto { PageSize = request.PageSize };
        await GetLlmAppListAsync();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (request.Page != args.Page)
        {
            request.Page = args.Page;
        }

        if (request.PageSize != args.PageSize)
        {
            request.PageSize = args.PageSize;
        }

        await GetLlmAppListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";


    /// <summary>
    /// 返回启用状态展示文案
    /// </summary>
    static string EnableStatusText(bool isEnable) => isEnable ? "启用中" : "已停用";


    /// <summary>
    /// 返回启用状态标签颜色
    /// </summary>
    static string EnableStatusColor(bool isEnable) => isEnable ? "#3b82f6" : "#94a3b8";

    bool isShowEdit = false;
    bool saveLoading = false;
    bool testLoading = false;
    long? editId;
    EditLlmAppDto editLlmApp = new();
    TestLlmAppResultDto? testResult;
    List<TestParamItem> testParamItems = [];

    static readonly System.Text.RegularExpressions.Regex PlaceholderRegex = new(@"\{\{\s*(?<required>\*)?\s*(?<key>[^{}|\s]+)\s*(?:\|\s*(?<comment>[^{}]*?))?\s*\}\}", System.Text.RegularExpressions.RegexOptions.Compiled);

    List<PlaceholderInfo> PlaceholderInfos
    {
        get
        {
            List<PlaceholderInfo> list = [];
            Dictionary<string, int> indexByKey = new(StringComparer.OrdinalIgnoreCase);

            void Collect(string? template)
            {
                if (string.IsNullOrWhiteSpace(template))
                {
                    return;
                }

                foreach (System.Text.RegularExpressions.Match m in PlaceholderRegex.Matches(template))
                {
                    var key = m.Groups["key"].Value?.Trim();
                    var isRequired = m.Groups["required"].Success;
                    var comment = m.Groups["comment"].Value?.Trim();

                    if (!string.IsNullOrWhiteSpace(key))
                    {
                        if (indexByKey.TryGetValue(key, out var index))
                        {
                            var existing = list[index];
                            var mergedComment = string.IsNullOrWhiteSpace(existing.Comment) ? comment : existing.Comment;

                            if (existing.IsRequired != isRequired || !string.Equals(existing.Comment, mergedComment, StringComparison.Ordinal))
                            {
                                list[index] = new PlaceholderInfo(existing.Key, existing.IsRequired || isRequired, mergedComment);
                            }
                        }
                        else
                        {
                            indexByKey[key] = list.Count;
                            list.Add(new PlaceholderInfo(key, isRequired, comment));
                        }
                    }
                }
            }

            Collect(editLlmApp.SystemPromptTemplate);
            Collect(editLlmApp.PromptTemplate);

            return list;
        }
    }

    TestParamItem GetOrCreateTestParamItem(string key)
    {
        var item = testParamItems.FirstOrDefault(t => t.Key.Equals(key, StringComparison.OrdinalIgnoreCase));
        if (item == null)
        {
            item = new TestParamItem { Key = key, Value = string.Empty };
            testParamItems.Add(item);
        }
        return item;
    }

    async Task EditLlmApp(LlmAppDto? row = null)
    {
        if (row == null)
        {
            editId = null;
            editLlmApp = new EditLlmAppDto { IsEnable = true };
        }
        else
        {
            editId = row.Id;
            editLlmApp = new EditLlmAppDto
            {
                Code = row.Code,
                Name = row.Name,
                LlmModelId = row.LlmModelId,
                SystemPromptTemplate = row.SystemPromptTemplate,
                PromptTemplate = row.PromptTemplate,
                ExtraBodyJson = row.ExtraBodyJson,
                IsEnable = row.IsEnable,
                Remark = row.Remark
            };
        }

        testResult = null;
        testParamItems = [];

        await GetModelSelectListAsync();
        await Task.Delay(150);
        isShowEdit = true;
        StateHasChanged();
    }

    async Task SaveLlmAppAsync()
    {
        if (string.IsNullOrWhiteSpace(editLlmApp.Code))
        {
            Message.Error("Code 不可以空");
            return;
        }

        if (string.IsNullOrWhiteSpace(editLlmApp.Name))
        {
            Message.Error("名称不可以空");
            return;
        }

        if (editLlmApp.LlmModelId == 0)
        {
            Message.Error("请选择模型");
            return;
        }

        if (string.IsNullOrWhiteSpace(editLlmApp.PromptTemplate))
        {
            Message.Error("PromptTemplate 不可以空");
            return;
        }

        saveLoading = true;
        try
        {
            using HttpResponseMessage httpResponse = editId == null
                ? await Http.PostAsJsonAsync("Operations/CreateLlmApp", editLlmApp, JsonHelper.SerializeOpts)
                : await Http.PostAsJsonAsync("Operations/UpdateLlmApp?id=" + editId.Value, editLlmApp, JsonHelper.SerializeOpts);

            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("保存成功");
                isShowEdit = false;
                await GetLlmAppListAsync();
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("保存失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            saveLoading = false;
            StateHasChanged();
        }
    }

    async Task TestCallAsync()
    {
        if (editLlmApp.LlmModelId == 0)
        {
            Message.Error("请先选择模型");
            return;
        }

        testLoading = true;
        testResult = null;

        var missing = PlaceholderInfos
            .Where(t => t.IsRequired)
            .Where(t => string.IsNullOrWhiteSpace(GetOrCreateTestParamItem(t.Key).Value))
            .Select(t => t.Display)
            .ToList();

        if (missing.Count != 0)
        {
            Message.Error("必传参数未填写: " + string.Join("、", missing));
            testLoading = false;
            return;
        }

        Dictionary<string, System.Text.Json.Nodes.JsonNode>? extraBody;
        try
        {
            extraBody = ParseExtraBody(editLlmApp.ExtraBodyJson);
        }
        catch (Exception ex)
        {
            Message.Error(ex.Message);
            testLoading = false;
            return;
        }

        var req = new TestLlmAppRequestDto
        {
            LlmModelId = editLlmApp.LlmModelId,
            SystemPromptTemplate = editLlmApp.SystemPromptTemplate,
            PromptTemplate = editLlmApp.PromptTemplate ?? string.Empty,
            ExtraBody = extraBody,
            Parameters = PlaceholderInfos.ToDictionary(k => k.Key, k => GetOrCreateTestParamItem(k.Key).Value, StringComparer.OrdinalIgnoreCase)
        };

        try
        {
            using var httpResponse = await Http.PostAsJsonAsync("Operations/TestLlmApp", req, JsonHelper.SerializeOpts);

            if (httpResponse.IsSuccessStatusCode)
            {
                testResult = await httpResponse.Content.ReadFromJsonAsync<TestLlmAppResultDto>(JsonHelper.DeserializeOpts);
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("调用失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            testLoading = false;
            StateHasChanged();
        }
    }

    record PlaceholderInfo(string Key, bool IsRequired, string? Comment)
    {
        public string Display
        {
            get
            {
                var text = string.IsNullOrWhiteSpace(Comment) ? Key : $"{Key}（{Comment}）";
                return IsRequired ? text + "*" : text;
            }
        }
    }

    class TestParamItem
    {
        public string Key { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    static Dictionary<string, System.Text.Json.Nodes.JsonNode>? ParseExtraBody(string? extraBodyJson)
    {
        if (string.IsNullOrWhiteSpace(extraBodyJson))
        {
            return null;
        }

        try
        {
            var node = System.Text.Json.Nodes.JsonNode.Parse(extraBodyJson);
            if (node is not System.Text.Json.Nodes.JsonObject obj)
            {
                throw new Exception("not object");
            }

            Dictionary<string, System.Text.Json.Nodes.JsonNode> dict = new(StringComparer.Ordinal);
            foreach (var kv in obj)
            {
                if (!string.IsNullOrWhiteSpace(kv.Key) && kv.Value != null)
                {
                    dict[kv.Key] = kv.Value;
                }
            }

            return dict.Count == 0 ? null : dict;
        }
        catch
        {
            throw new Exception("ExtraBodyJson 不是合法的 JSON 对象");
        }
    }

    async Task DeleteLlmAppAsync(long id)
    {
        try
        {
            using var httpResponse = await Http.DeleteAsync("Operations/DeleteLlmApp?id=" + id);

            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("删除成功");
                await GetLlmAppListAsync();
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("删除失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
    }
}
