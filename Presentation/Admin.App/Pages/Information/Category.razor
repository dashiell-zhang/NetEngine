@page "/information/category"
@using Application.Model.Site.Article
@attribute [ReuseTabsPageTitle("栏目管理")]

<div class="category-page admin-page">
    <div class="category-page__hero admin-page__hero admin-page__hero--with-actions">
        <div>
            <div class="category-page__eyebrow admin-page__eyebrow">Information Management</div>
            <h2 class="category-page__title admin-page__title">栏目管理工作台</h2>
            <div class="category-page__subtitle admin-page__subtitle">统一维护栏目名称、父级结构和排序规则，让内容结构调整、栏目新增和维护都在一个视图内完成</div>

            @if (functionList.Contains("category-add"))
            {
                <div class="category-page__hero-tools admin-page__hero-tools">
                    <Button Class="category-page__action-button category-page__action-button--primary admin-page-button admin-page-button--primary admin-page-button--with-plus" Type="@ButtonType.Primary" @onclick="() => EditCategoryAsync()"><span class="admin-page-button__content"><span class="admin-page-button__icon" aria-hidden="true">+</span><span class="admin-page-button__text">新增栏目</span><span class="admin-page-button__spacer" aria-hidden="true"></span></span></Button>
                </div>
            }
        </div>

        <div class="category-page__stats admin-page__stats">
            <div class="category-page__stat-card admin-page__stat-card">
                <span class="category-page__stat-label admin-page__stat-label">栏目总量</span>
                <strong class="category-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="category-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 个栏目</span>
            </div>

            <div class="category-page__stat-card admin-page__stat-card">
                <span class="category-page__stat-label admin-page__stat-label">当前页顶级</span>
                <strong class="category-page__stat-value admin-page__stat-value">@RootCategoryCount()</strong>
                <span class="category-page__stat-foot admin-page__stat-foot">无父级栏目会作为顶层结构直接展示</span>
            </div>

            <div class="category-page__stat-card admin-page__stat-card">
                <span class="category-page__stat-label admin-page__stat-label">默认排序</span>
                <strong class="category-page__stat-value category-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@SortBaselineText()</strong>
                <span class="category-page__stat-foot admin-page__stat-foot">新增栏目默认采用当前排序基线</span>
            </div>
        </div>
    </div>

    <Card Class="category-page__card category-page__card--compact admin-page__card admin-page__card--compact">
        <div class="category-page__list-shell admin-page-list-shell">
            <div class="category-page__table-wrap admin-page__table-wrap">
                <Table TItem="CategoryDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="栏目">
                            <div class="category-page__name-cell admin-page__name-cell">
                                <div class="category-page__name-title admin-page__name-title" title="@context.Name">@context.Name</div>
                                <div class="category-page__name-sub" title="@ParentCategoryText(context)">@ParentCategoryText(context)</div>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="备注">
                            <div class="category-page__remark-cell admin-page__remark-cell" title="@RemarkText(context)">@RemarkText(context)</div>
                        </ActionColumn>

                        <ActionColumn Title="排序">
                            <div class="category-page__sort-pill admin-page__sort-pill">@context.Sort</div>
                        </ActionColumn>

                        <ActionColumn Title="创建时间">
                            <div class="category-page__time-cell admin-page__time-cell">@context.CreateTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div>
                        </ActionColumn>

                        <ActionColumn Title="操作">
                            <Space>
                                @if (functionList.Contains("category-edit"))
                                {
                                    <SpaceItem>
                                        <a class="category-page__link-action admin-page__link-action" @onclick="() => EditCategoryAsync(context)">编辑</a>
                                    </SpaceItem>
                                }

                                @if (functionList.Contains("category-delete"))
                                {
                                    <SpaceItem>
                                        <Popconfirm Title="确认要删除吗？"
                                                    OnConfirm="_ => DeleteCategoryAsync(context.Id)"
                                                    OkText="Yes"
                                                    CancelText="No">
                                            <a class="category-page__link-action category-page__link-action--danger admin-page__link-action admin-page__link-action--danger">删除</a>
                                        </Popconfirm>
                                    </SpaceItem>
                                }
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="category-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="pageSize" Current="page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="700" Visible="isShowEditCategory" Title='(categoryId == default ? "新增栏目" : "编辑栏目")' OnClose="() => isShowEditCategory = false">
    <Template>
        <div class="category-drawer admin-drawer">
            <Form Class="category-drawer__form admin-drawer__form admin-form" Model="@editCategory" Layout="@FormLayout.Vertical" OnFinish="SaveCategoryAsync">
                <div class="category-drawer__section admin-drawer__section">
                    <div class="category-drawer__section-title admin-drawer__section-title">基础资料</div>

                    <Row Gutter="24">
                        <AntDesign.Col Span="14">
                            <FormItem Class="category-drawer__field-item admin-form__field-item">
                                <div class="category-drawer__field-label admin-form__field-label admin-required-label">名称</div>
                                <Input Placeholder="请输入名称" @bind-Value="@context.Name" />
                            </FormItem>
                        </AntDesign.Col>

                        <AntDesign.Col Span="10">
                            <FormItem Class="category-drawer__field-item admin-form__field-item">
                                <div class="category-drawer__field-label admin-form__field-label">排序</div>
                                <Input Placeholder="请输入排序值" Type="InputType.Number" @bind-Value="@context.Sort" />
                            </FormItem>
                        </AntDesign.Col>
                    </Row>

                    <FormItem Class="category-drawer__field-item admin-form__field-item">
                        <div class="category-drawer__field-label admin-form__field-label">父级栏目</div>
                        <TreeSelect TItem="TreeSelectDto" TItemValue="string" DataSource="selectCategoryList" @bind-Value="@parentId" Placeholder="请选择父级栏目" TreeDefaultExpandAll ChildrenExpression="node => node.DataItem.Children" DisabledExpression="node => node.DataItem.IsDisabled" TitleExpression="node => node.DataItem.Title" KeyExpression="node => node.DataItem.Key" IsLeafExpression="node => node.DataItem.Children == null"></TreeSelect>
                    </FormItem>

                    <FormItem Class="category-drawer__field-item admin-form__field-item">
                        <div class="category-drawer__field-label admin-form__field-label">备注</div>
                        <Input Placeholder="请输入备注" @bind-Value="@context.Remark" />
                    </FormItem>
                </div>

                <div class="category-drawer__footer admin-drawer__footer">
                    <Button Class="category-page__action-button category-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Loading="@saveLoading">保存栏目</Button>
                    <Button Class="category-page__action-button category-page__action-button--default admin-page-button admin-page-button--default" Type="@ButtonType.Default" @onclick="() => isShowEditCategory = false">取消</Button>
                </div>
            </Form>
        </div>
    </Template>
</Drawer>




@code {

    string parentId = "0";

    List<TreeSelectDto>? selectCategoryList = new();

    List<string> functionList = new();

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();
    }

    override protected async Task OnParametersSetAsync()
    {
        var getCategoryListTask = GetCategoryListAsync();
        var getCategorySelectListTask = GetCategorySelectListAsync();

        await Task.WhenAll(getCategoryListTask, getCategorySelectListTask);
    }


    async Task GetCategorySelectListAsync()
    {
        List<CategorySelectDto> parentKVList = new();


        parentKVList.Add(new CategorySelectDto { Id = 0, Name = "无父级栏目" });



        var kvList = await Http.GetFromJsonAsync<List<CategorySelectDto>>("Article/GetCategorySelectList", JsonHelper.DeserializeOpts);

        if (kvList != null)
        {
            parentKVList.AddRange(kvList);

            selectCategoryList = CategoryTreeConvert(parentKVList)!.ToList();
        }

    }

    private IEnumerable<TreeSelectDto>? CategoryTreeConvert(List<CategorySelectDto>? keyValueChildren)
    {
        return keyValueChildren?.Select(t => new TreeSelectDto
        {
            Key = t.Id.ToString()!,
            Title = t.Name!.ToString()!,
            Children = CategoryTreeConvert(t.ChildList),
            IsDisabled = (categoryId == t.Id && categoryId != 0)
        }).ToList();
    }

    bool saveLoading = false;


    bool tableLoading = false;
    int page = 1;
    int pageSize = 10;
    PageListDto<CategoryDto> pageList = new();

    async Task GetCategoryListAsync()
    {
        tableLoading = true;
        var retData = await Http.GetFromJsonAsync<PageListDto<CategoryDto>>("Article/GetCategoryList?page=" + page + "&pageSize=" + pageSize, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (page != args.Page)
        {
            page = args.Page;
        }

        if (pageSize != args.PageSize)
        {
            pageSize = args.PageSize;
        }

        await GetCategoryListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";


    bool isShowEditCategory = false;
    EditCategoryDto editCategory = new();
    long categoryId;


    async Task EditCategoryAsync(CategoryDto? category = null)
    {
        editCategory = new();
        categoryId = default;

        if (category != null)
        {
            categoryId = category.Id;
            editCategory.Name = category.Name;
            editCategory.Remark = category.Remark;
            editCategory.Sort = category.Sort;

            if (category.ParentId == null)
            {
                editCategory.ParentId = 0;
            }
            else
            {
                editCategory.ParentId = category.ParentId;
            }

            parentId = editCategory.ParentId.Value.ToString();
        }
        else
        {
            editCategory.Sort = 99;
            parentId = "0";
        }

        var getCategorySelectListTask = GetCategorySelectListAsync();

        await Task.WhenAll(getCategorySelectListTask, Task.Delay(200));

        isShowEditCategory = true;

        StateHasChanged();
    }

    async Task SaveCategoryAsync()
    {
        saveLoading = true;
        try
        {
            if (parentId == "0")
            {
                editCategory.ParentId = null;
            }
            else
            {
                editCategory.ParentId = long.Parse(parentId);
            }

            if (categoryId == default)
            {
                using var httpResponse = await Http.PostAsJsonAsync<EditCategoryDto>("Article/CreateCategory", editCategory, JsonHelper.SerializeOpts);
                if (httpResponse.IsSuccessStatusCode)
                {
                    Message.Success("添加成功");
                    isShowEditCategory = false;
                    await GetCategoryListAsync();
                }
                else if ((int)httpResponse.StatusCode != 400)
                {
                    Message.Error("添加失败");
                }
            }
            else
            {
                using var httpResponse = await Http.PostAsJsonAsync<EditCategoryDto>("Article/UpdateCategory?categoryId=" + categoryId, editCategory, JsonHelper.SerializeOpts);

                if (httpResponse.IsSuccessStatusCode)
                {
                    Message.Success("编辑成功");
                    isShowEditCategory = false;
                    await GetCategoryListAsync();
                }
                else if ((int)httpResponse.StatusCode != 400)
                {
                    Message.Error("编辑失败");
                }
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            saveLoading = false;
            StateHasChanged();
        }
    }


    async Task DeleteCategoryAsync(long categoryId)
    {
        try
        {
            using var httpResponse = await Http.DeleteAsync("Article/DeleteCategory?id=" + categoryId);
            if (httpResponse.IsSuccessStatusCode)
            {
                await GetCategoryListAsync();
                Message.Success("删除成功");
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("删除失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
    }


    /// <summary>
    /// 获取当前页顶级栏目数量
    /// </summary>
    int RootCategoryCount()
    {
        return pageList.List?.Count(item => item.ParentId == null) ?? 0;
    }


    /// <summary>
    /// 获取父级栏目显示文本
    /// </summary>
    string ParentCategoryText(CategoryDto category)
    {
        return string.IsNullOrWhiteSpace(category.ParentName) ? "无父级栏目" : category.ParentName;
    }


    /// <summary>
    /// 获取备注显示文本
    /// </summary>
    string RemarkText(CategoryDto category)
    {
        return string.IsNullOrWhiteSpace(category.Remark) ? "暂无备注说明" : category.Remark;
    }


    /// <summary>
    /// 获取默认排序描述
    /// </summary>
    string SortBaselineText()
    {
        return "99 起";
    }


}
