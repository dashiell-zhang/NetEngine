@page "/login"
@layout NullLayout
@using Application.Model.Authorize
@using Microsoft.IdentityModel.JsonWebTokens;
@attribute [ReuseTabsPage(Ignore = true)]


<body class="login-page">
    <div class="login-page__backdrop">

        <div class="login-page__welcome">
            <div class="login-page__welcome-title">
                Welcome
            </div>
            <div class="login-page__welcome-subtitle">
                Hi，你来啦！
            </div>
        </div>

        <div class="login-page__panel">
            <h1>管理系统</h1>

            <Form Class="login-page__form admin-form" Model="@loginData" OnFinish="LoginActionAsync">

                <FormItem>
                    <Input @bind-Value="@context.UserName" Placeholder="用户名" />
                </FormItem>

                <FormItem>
                    <InputPassword @bind-Value="@context.Password" Placeholder="密码" />
                </FormItem>

                <FormItem Class="login-page__submit-item">
                    <Button Class="login-page__submit-button admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Block Loading="@submitLoading">
                        登录
                    </Button>
                </FormItem>
            </Form>
        </div>

    </div>
</body>


@code
{
    bool submitLoading = false;


    override protected void OnInitialized()
    {
        var authorization = LocalStorage.GetItemAsString("Authorization");

        if (!string.IsNullOrEmpty(authorization))
        {
            try
            {
                JsonWebToken jsonWebToken = new(authorization);

                var expClaim = jsonWebToken.GetClaim("exp");
                if (expClaim == null)
                {
                    return;
                }

                var expTimeL = Convert.ToInt64(expClaim.Value);

                var expTime = DateTimeOffset.FromUnixTimeSeconds(expTimeL);

                if (expTime > DateTimeOffset.UtcNow)
                {
                    NavigationManager.NavigateTo("", true);
                }
            }
            catch
            {
                LocalStorage.RemoveItem("Authorization");
            }
        }
    }


    private GetTokenDto loginData = new();

    private async Task LoginActionAsync()
    {
        submitLoading = true;
        try
        {
            using var httpResponse = await Http.PostAsJsonAsync<GetTokenDto>("Authorize/GetToken", loginData, JsonHelper.SerializeOpts);

            if (httpResponse.IsSuccessStatusCode)
            {
                var token = await httpResponse.Content.ReadAsStringAsync();
                LocalStorage.SetItemAsString("Authorization", token);
                NavigationManager.NavigateTo("", true);
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("登录失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            submitLoading = false;
            StateHasChanged();
        }
    }

}
