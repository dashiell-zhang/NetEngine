@page "/systemset/link"
@using Application.Model.Site.Link
@attribute [ReuseTabsPageTitle("友链管理")]

<div class="system-link-page admin-page">
    <div class="system-link-page__hero admin-page__hero admin-page__hero--with-actions">
        <div>
            <div class="system-link-page__eyebrow admin-page__eyebrow">System Settings</div>
            <h2 class="system-link-page__title admin-page__title">友链管理工作台</h2>
            <div class="system-link-page__subtitle admin-page__subtitle">统一维护友链名称、地址与展示顺序，让新增、编辑和上下线管理都在同一个页面中完成</div>

            @if (functionList.Contains("link-add"))
            {
                <div class="system-link-page__hero-tools admin-page__hero-tools">
                    <Button Class="system-link-page__action-button system-link-page__action-button--primary admin-page-button admin-page-button--primary admin-page-button--with-plus" Type="@ButtonType.Primary" @onclick="() => EditLink()"><span class="admin-page-button__content"><span class="admin-page-button__icon" aria-hidden="true">+</span><span class="admin-page-button__text">新增友链</span><span class="admin-page-button__spacer" aria-hidden="true"></span></span></Button>
                </div>
            }
        </div>

        <div class="system-link-page__stats admin-page__stats">
            <div class="system-link-page__stat-card admin-page__stat-card">
                <span class="system-link-page__stat-label admin-page__stat-label">友链总量</span>
                <strong class="system-link-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="system-link-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 条链接</span>
            </div>

            <div class="system-link-page__stat-card admin-page__stat-card">
                <span class="system-link-page__stat-label admin-page__stat-label">操作能力</span>
                <strong class="system-link-page__stat-value system-link-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@OperationCapabilityText()</strong>
                <span class="system-link-page__stat-foot admin-page__stat-foot">支持新增、编辑和删除等维护动作</span>
            </div>

            <div class="system-link-page__stat-card admin-page__stat-card">
                <span class="system-link-page__stat-label admin-page__stat-label">默认排序</span>
                <strong class="system-link-page__stat-value system-link-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@DefaultSortText()</strong>
                <span class="system-link-page__stat-foot admin-page__stat-foot">新增友链默认使用当前排序基线</span>
            </div>
        </div>
    </div>

    <Card Class="system-link-page__card system-link-page__card--compact admin-page__card admin-page__card--compact">
        <div class="system-link-page__list-shell admin-page-list-shell">
            <div class="system-link-page__table-wrap admin-page__table-wrap">
                <Table TItem="LinkDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="友链">
                            <div class="system-link-page__link-cell" title="@(context.Name + " / " + context.Url)">
                                <div class="system-link-page__link-name">@context.Name</div>
                                <span class="system-link-page__link-divider">/</span>
                                <a class="system-link-page__url-link" href="@context.Url" target="_blank" rel="noopener noreferrer">@context.Url</a>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="排序">
                            <div class="system-link-page__sort-pill admin-page__sort-pill admin-page__sort-pill--flat">@context.Sort</div>
                        </ActionColumn>

                        <ActionColumn Title="创建时间">
                            <div class="system-link-page__time-cell admin-page__time-cell">@context.CreateTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</div>
                        </ActionColumn>

                        <ActionColumn Title="操作">
                            <Space>
                                @if (functionList.Contains("link-edit"))
                                {
                                    <SpaceItem>
                                        <a class="system-link-page__link-action admin-page__link-action" @onclick="() => EditLink(context)">编辑</a>
                                    </SpaceItem>
                                }

                                @if (functionList.Contains("link-delete"))
                                {
                                    <SpaceItem>
                                        <Popconfirm Title="确认要删除吗？"
                                                    OnConfirm="_ => DeleteLinkAsync(context.Id)"
                                                    OkText="Yes"
                                                    CancelText="No">
                                            <a class="system-link-page__link-action system-link-page__link-action--danger admin-page__link-action admin-page__link-action--danger">删除</a>
                                        </Popconfirm>
                                    </SpaceItem>
                                }
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="system-link-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="pageSize" Current="page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="700" Visible="isShowEditLink" Title='(linkId == default ? "新增友链" : "编辑友链")' OnClose="() => isShowEditLink = false">
    <Template>
        <div class="system-link-drawer admin-drawer admin-drawer--compact">
            <Form Class="system-link-drawer__form admin-drawer__form admin-form admin-form--compact" Model="@editLink" Layout="@FormLayout.Vertical" OnFinish="SaveLinkAsync">
                <div class="system-link-drawer__section admin-drawer__section">
                    <div class="system-link-drawer__section-title admin-drawer__section-title">基础资料</div>

                    <Row Gutter="24">
                        <AntDesign.Col Span="16">
                            <FormItem Class="system-link-drawer__field-item admin-form__field-item">
                                <div class="system-link-drawer__field-label admin-form__field-label admin-required-label">名称</div>
                                <Input Placeholder="请输入名称" @bind-Value="@context.Name" />
                            </FormItem>
                        </AntDesign.Col>

                        <AntDesign.Col Span="8">
                            <FormItem Class="system-link-drawer__field-item admin-form__field-item">
                                <div class="system-link-drawer__field-label admin-form__field-label">排序</div>
                                <Input Placeholder="请输入排序值" Type="InputType.Number" @bind-Value="@context.Sort" />
                            </FormItem>
                        </AntDesign.Col>
                    </Row>

                    <FormItem Class="system-link-drawer__field-item admin-form__field-item">
                        <div class="system-link-drawer__field-label admin-form__field-label admin-required-label">Url</div>
                        <Input Placeholder="请输入Url" Type="InputType.Url" @bind-Value="@context.Url" />
                    </FormItem>
                </div>

                <div class="system-link-drawer__footer admin-drawer__footer">
                    <Button Class="system-link-page__action-button system-link-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Loading="@saveLoading">保存友链</Button>
                    <Button Class="system-link-page__action-button system-link-page__action-button--default admin-page-button admin-page-button--default" Type="@ButtonType.Default" @onclick="() => isShowEditLink = false">取消</Button>
                </div>
            </Form>
        </div>
    </Template>
</Drawer>




@code {

    List<string> functionList = new();

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();

        await GetLinkListAsync();
    }

    bool saveLoading = false;
    bool tableLoading = false;
    int page = 1;
    int pageSize = 10;

    PageListDto<LinkDto> pageList = new();

    async Task GetLinkListAsync()
    {
        tableLoading = true;
        var retData = await Http.GetFromJsonAsync<PageListDto<LinkDto>>("Site/GetLinkList?page=" + page + "&pageSize=" + pageSize, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (page != args.Page)
        {
            page = args.Page;
        }

        if (pageSize != args.PageSize)
        {
            pageSize = args.PageSize;
        }

        await GetLinkListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";


    bool isShowEditLink = false;

    long linkId;
    EditLinkDto editLink = new();

    void EditLink(LinkDto? link = null)
    {
        linkId = default;
        editLink = new EditLinkDto();

        if (link != null)
        {
            linkId = link.Id;
            editLink.Name = link.Name;
            editLink.Url = link.Url;
            editLink.Sort = link.Sort;
        }
        else
        {
            editLink.Sort = 99;
        }

        isShowEditLink = true;

        StateHasChanged();
    }

    async Task SaveLinkAsync()
    {
        saveLoading = true;
        try
        {
            if (linkId == default)
            {
                using var httpResponse = await Http.PostAsJsonAsync<EditLinkDto>("Site/CreateLink", editLink, JsonHelper.SerializeOpts);
                if (httpResponse.IsSuccessStatusCode)
                {
                    Message.Success("添加成功");
                    isShowEditLink = false;
                    await GetLinkListAsync();
                }
                else if ((int)httpResponse.StatusCode != 400)
                {
                    Message.Error("添加失败");
                }
            }
            else
            {
                using var httpResponse = await Http.PostAsJsonAsync<EditLinkDto>("Site/UpdateLink?linkId=" + linkId, editLink, JsonHelper.SerializeOpts);
                if (httpResponse.IsSuccessStatusCode)
                {
                    Message.Success("编辑成功");
                    isShowEditLink = false;
                    await GetLinkListAsync();
                }
                else if ((int)httpResponse.StatusCode != 400)
                {
                    Message.Error("编辑失败");
                }
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            saveLoading = false;
            StateHasChanged();
        }
    }


    async Task DeleteLinkAsync(long linkId)
    {
        try
        {
            using var httpResponse = await Http.DeleteAsync("Site/DeleteLink?id=" + linkId);
            if (httpResponse.IsSuccessStatusCode)
            {
                await GetLinkListAsync();
                Message.Success("删除成功");
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("删除失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
    }


    /// <summary>
    /// 获取当前操作能力描述
    /// </summary>
    string OperationCapabilityText()
    {
        var count = 0;

        if (functionList.Contains("link-add"))
        {
            count++;
        }

        if (functionList.Contains("link-edit"))
        {
            count++;
        }

        if (functionList.Contains("link-delete"))
        {
            count++;
        }

        return count == 0 ? "只读查看" : $"{count} 项能力";
    }


    /// <summary>
    /// 获取默认排序描述
    /// </summary>
    string DefaultSortText()
    {
        return "99 起";
    }

}
