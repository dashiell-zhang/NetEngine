<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<DebugType>embedded</DebugType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<NoWarn>1591;8618;CA2254</NoWarn>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<NoWarn>1591;8618;CA2254</NoWarn>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
	  <FrameworkReference Include="Microsoft.AspNetCore.App" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
	  <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
	  <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
	  <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
	  <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
	  <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
	  <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Application\Application.Model\Application.Model.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\Common\Common.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\DistributedLock\DistributedLock.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Using Include="Microsoft.AspNetCore.Builder" />
	  <Using Include="Microsoft.AspNetCore.Hosting" />
	  <Using Include="Microsoft.AspNetCore.Http" />
	  <Using Include="Microsoft.AspNetCore.Routing" />
	  <Using Include="Microsoft.Extensions.Configuration" />
	  <Using Include="Microsoft.Extensions.DependencyInjection" />
	  <Using Include="Microsoft.Extensions.Hosting" />
	  <Using Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

</Project>
