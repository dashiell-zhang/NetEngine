@page "/operations/scheduletasksetting"
@using Application.Model.TaskCenter
@attribute [ReuseTabsPageTitle("定时任务配置")]

<div class="schedule-task-page admin-page">
    <div class="schedule-task-page__hero admin-page__hero admin-page__hero--with-actions">
        <div>
            <div class="schedule-task-page__eyebrow admin-page__eyebrow">Operations</div>
            <h2 class="schedule-task-page__title admin-page__title">定时任务配置台</h2>
            <div class="schedule-task-page__subtitle admin-page__subtitle">统一维护 ScheduleTask 分类任务的启停状态、Cron 表达式与参数 JSON，让日常运维配置、排查和更新都在一个视图内完成</div>

            <div class="schedule-task-page__hero-tools admin-page__hero-tools">
                <Button Class="schedule-task-page__hero-button admin-page-button admin-page-button--primary admin-page-button--with-plus" Type="@ButtonType.Primary" @onclick="ShowCreateScheduleTaskAsync"><span class="admin-page-button__content"><span class="admin-page-button__icon" aria-hidden="true">+</span><span class="admin-page-button__text">新增带参任务</span><span class="admin-page-button__spacer" aria-hidden="true"></span></span></Button>
                <Button Class="schedule-task-page__hero-button schedule-task-page__hero-button--light admin-page-button admin-page-button--default" Icon="reload" @onclick="GetTaskSettingListAsync">刷新列表</Button>
            </div>
        </div>

        <div class="schedule-task-page__stats admin-page__stats">
            <div class="schedule-task-page__stat-card admin-page__stat-card">
                <span class="schedule-task-page__stat-label admin-page__stat-label">任务总量</span>
                <strong class="schedule-task-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="schedule-task-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 条配置</span>
            </div>

            <div class="schedule-task-page__stat-card admin-page__stat-card">
                <span class="schedule-task-page__stat-label admin-page__stat-label">当前页启用</span>
                <strong class="schedule-task-page__stat-value admin-page__stat-value">@(pageList.List?.Count(t => t.IsEnable) ?? 0)</strong>
                <span class="schedule-task-page__stat-foot admin-page__stat-foot">可直接观察当前页任务启停分布</span>
            </div>

            <div class="schedule-task-page__stat-card admin-page__stat-card">
                <span class="schedule-task-page__stat-label admin-page__stat-label">分页状态</span>
                <strong class="schedule-task-page__stat-value schedule-task-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">第 @(page) 页 / 每页 @pageSize 条</strong>
                <span class="schedule-task-page__stat-foot admin-page__stat-foot">当前分类固定为 ScheduleTask</span>
            </div>
        </div>
    </div>

    <Card Class="schedule-task-page__card schedule-task-page__card--compact admin-page__card admin-page__card--compact">
        <div class="schedule-task-page__list-shell admin-page-list-shell">
            <div class="schedule-task-page__table-wrap admin-page__table-wrap">
                <Table TItem="TaskSettingDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="任务">
                            <div class="schedule-task-page__name-cell admin-page__name-cell">
                                <div class="schedule-task-page__name-title admin-page__name-title">@context.Name</div>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="状态">
                            <Tag Class="schedule-task-page__status-tag admin-page__status-tag" Color="@(context.IsEnable ? "#16a34a" : "#94a3b8")">@(context.IsEnable ? "启用中" : "已停用")</Tag>
                        </ActionColumn>

                        <ActionColumn Title="Cron">
                            <div class="schedule-task-page__cron-cell">@(string.IsNullOrWhiteSpace(context.Cron) ? "未配置" : context.Cron)</div>
                        </ActionColumn>

                        <ActionColumn Title="备注">
                            <div class="schedule-task-page__remark-cell admin-page__remark-cell">@(string.IsNullOrWhiteSpace(context.Remark) ? "暂无备注说明" : context.Remark)</div>
                        </ActionColumn>

                        <PropertyColumn Property="c => (c.UpdateTime ?? c.CreateTime).LocalDateTime" Format="yyyy-MM-dd HH:mm" Title="更新时间"></PropertyColumn>

                        <ActionColumn Title="操作">
                            <Space>
                                <SpaceItem>
                                    <a class="schedule-task-page__link admin-page__link" @onclick="() => EditTaskSettingAsync(context)">编辑</a>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="schedule-task-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="pageSize" Current="page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="620" Visible="isShowEditTaskSetting" Title='("任务配置")' OnClose="() => isShowEditTaskSetting = false">
    <Template>
        <div class="schedule-task-drawer admin-drawer">
            <Form Class="schedule-task-drawer__form admin-drawer__form admin-form" Model="@editTaskSetting" Layout="@FormLayout.Vertical" OnFinish="SaveTaskSettingAsync">
                <div class="schedule-task-drawer__section admin-drawer__section">
                    <div class="schedule-task-drawer__edit-overview">
                        <div class="schedule-task-drawer__edit-main">
                            <div class="schedule-task-drawer__overview-eyebrow">当前任务</div>
                            <div class="schedule-task-drawer__overview-title">@(string.IsNullOrWhiteSpace(taskName) ? "未命名任务" : taskName)</div>
                        </div>

                        <div class="schedule-task-drawer__switch-box admin-drawer__switch-box">
                            <span class="schedule-task-drawer__switch-label admin-drawer__switch-label">是否启用</span>
                            <Switch @bind-Value="@editTaskSetting.IsEnable" CheckedChildren="是" UnCheckedChildren="否" />
                        </div>
                    </div>

                    <FormItem Class="schedule-task-drawer__field-item admin-form__field-item">
                        <div class="schedule-task-drawer__field-label admin-form__field-label">Cron</div>
                        <Input Placeholder="ScheduleTask 的 Cron 表达式" @bind-Value="@editTaskSetting.Cron" />
                    </FormItem>

                    <FormItem Class="schedule-task-drawer__field-item admin-form__field-item">
                        <div class="schedule-task-drawer__field-label admin-form__field-label">参数 JSON</div>
                        <TextArea Placeholder="带参任务参数 JSON" @bind-Value="@editTaskSetting.Parameter" MinRows="6" MaxRows="12" />
                        <div class="schedule-task-drawer__field-help admin-form__field-help">建议传入合法 JSON 对象，方便任务执行时直接反序列化使用</div>
                    </FormItem>

                    <FormItem Class="schedule-task-drawer__field-item admin-form__field-item">
                        <div class="schedule-task-drawer__field-label admin-form__field-label">备注</div>
                        <TextArea Placeholder="请输入备注" @bind-Value="@editTaskSetting.Remark" MinRows="4" MaxRows="8" />
                    </FormItem>
                </div>

                <div class="schedule-task-drawer__footer admin-drawer__footer">
                    <Button Class="schedule-task-page__action-button schedule-task-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Loading="@saveLoading">保存</Button>
                    <Button Class="schedule-task-page__action-button schedule-task-page__action-button--default admin-page-button admin-page-button--default" Type="@ButtonType.Default" @onclick="() => isShowEditTaskSetting = false">取消</Button>
                </div>
            </Form>
        </div>
    </Template>
</Drawer>


<Drawer Closable="true" Width="680" Visible="isShowCreateScheduleTask" Title='("新增带参定时任务")' OnClose="() => isShowCreateScheduleTask = false">
    <Template>
        <div class="schedule-task-drawer admin-drawer">
            <Form Class="schedule-task-drawer__form admin-drawer__form admin-form" Model="@createScheduleTask" Layout="@FormLayout.Vertical" OnFinish="CreateScheduleTaskAsync">
                <div class="schedule-task-drawer__section schedule-task-drawer__section--accent admin-drawer__section admin-drawer__section--accent">
                    <div class="schedule-task-drawer__create-head">
                        <div class="schedule-task-drawer__create-main">
                            <FormItem Class="schedule-task-drawer__field-item admin-form__field-item">
                                <div class="schedule-task-drawer__field-label admin-form__field-label admin-required-label">任务名称</div>
                                <Select TItem="string" TItemValue="string" @bind-Value="@createScheduleTask.Name" Placeholder="请选择任务名称" AllowClear ShowSearch>
                                    @foreach (var name in scheduleTaskNameList)
                                    {
                                        <SelectOption Value="@name" Label="@name"></SelectOption>
                                    }
                                </Select>
                            </FormItem>
                        </div>

                        <div class="schedule-task-drawer__create-side">
                            <FormItem Class="schedule-task-drawer__field-item schedule-task-drawer__field-item--switch admin-form__field-item">
                                <div class="schedule-task-drawer__switch-panel admin-drawer__switch-box">
                                    <span class="schedule-task-drawer__switch-label admin-drawer__switch-label">是否启用</span>
                                    <Switch @bind-Value="@createScheduleTask.IsEnable" CheckedChildren="是" UnCheckedChildren="否" />
                                </div>
                            </FormItem>
                        </div>
                    </div>

                    <FormItem Class="schedule-task-drawer__field-item admin-form__field-item">
                        <div class="schedule-task-drawer__field-label admin-form__field-label">Cron</div>
                        <Input Placeholder="Cron 表达式（可选；为空则使用特性默认值）" @bind-Value="@createScheduleTask.Cron" />
                    </FormItem>

                    <FormItem Class="schedule-task-drawer__field-item admin-form__field-item">
                        <div class="schedule-task-drawer__field-label admin-form__field-label admin-required-label">参数 JSON</div>
                        <TextArea Placeholder="必填：带参任务参数 JSON" @bind-Value="@createScheduleTask.Parameter" MinRows="8" MaxRows="14" />
                        <div class="schedule-task-drawer__field-help admin-form__field-help">建议按对象结构组织字段，便于任务内部直接映射到请求模型</div>
                    </FormItem>

                    <FormItem Class="schedule-task-drawer__field-item admin-form__field-item">
                        <div class="schedule-task-drawer__field-label admin-form__field-label">备注</div>
                        <TextArea Placeholder="请输入备注" @bind-Value="@createScheduleTask.Remark" MinRows="4" MaxRows="8" />
                    </FormItem>
                </div>

                <div class="schedule-task-drawer__footer admin-drawer__footer">
                    <Button Class="schedule-task-page__action-button schedule-task-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit" Loading="@createLoading">新增</Button>
                    <Button Class="schedule-task-page__action-button schedule-task-page__action-button--default admin-page-button admin-page-button--default" Type="@ButtonType.Default" @onclick="() => isShowCreateScheduleTask = false">取消</Button>
                </div>
            </Form>
        </div>
    </Template>
</Drawer>



@code {

    List<string> functionList = new();

    const string PageCategory = "ScheduleTask";

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();
    }

    override protected async Task OnParametersSetAsync()
    {
        await GetTaskSettingListAsync();
    }

    bool tableLoading = false;
    int page = 1;
    int pageSize = 10;
    PageListDto<TaskSettingDto> pageList = new();


    async Task GetTaskSettingListAsync()
    {
        tableLoading = true;

        var retData = await Http.GetFromJsonAsync<PageListDto<TaskSettingDto>>("Operations/GetTaskSettingList?page=" + page + "&pageSize=" + pageSize + "&category=" + PageCategory, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (page != args.Page)
        {
            page = args.Page;
        }

        if (pageSize != args.PageSize)
        {
            pageSize = args.PageSize;
        }

        await GetTaskSettingListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";

    bool isShowEditTaskSetting = false;
    bool saveLoading = false;

    bool isShowCreateScheduleTask = false;
    bool createLoading = false;

    long taskSettingId;
    string? taskName;
    string? taskCategory;
    EditTaskSettingDto editTaskSetting = new();

    List<string> scheduleTaskNameList = [];
    CreateScheduleTaskDto createScheduleTask = new() { IsEnable = true };

    async Task EditTaskSettingAsync(TaskSettingDto taskSetting)
    {
        taskSettingId = taskSetting.Id;

        taskName = taskSetting.Name;
        taskCategory = taskSetting.Category;

        editTaskSetting = new EditTaskSettingDto
        {
            IsEnable = taskSetting.IsEnable,
            Cron = taskSetting.Cron,
            Semaphore = taskSetting.Semaphore,
            Parameter = taskSetting.Parameter,
            Remark = taskSetting.Remark
        };

        await Task.Delay(200);

        isShowEditTaskSetting = true;

        StateHasChanged();
    }

    async Task SaveTaskSettingAsync()
    {
        saveLoading = true;
        try
        {
            using var httpResponse = await Http.PostAsJsonAsync<EditTaskSettingDto>("Operations/UpdateTaskSetting?taskSettingId=" + taskSettingId, editTaskSetting, JsonHelper.SerializeOpts);

            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("编辑成功");
                isShowEditTaskSetting = false;
                await GetTaskSettingListAsync();
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("编辑失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            saveLoading = false;
            StateHasChanged();
        }
    }

    async Task ShowCreateScheduleTaskAsync()
    {
        createScheduleTask = new CreateScheduleTaskDto { IsEnable = true };

        var retData = await Http.GetFromJsonAsync<List<string>>("Operations/GetArgsScheduleTaskNameList", JsonHelper.DeserializeOpts);

        scheduleTaskNameList = retData ?? [];

        await Task.Delay(100);

        isShowCreateScheduleTask = true;

        StateHasChanged();
    }

    async Task CreateScheduleTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(createScheduleTask.Name))
        {
            Message.Error("请选择任务名称");
            return;
        }

        if (string.IsNullOrWhiteSpace(createScheduleTask.Parameter))
        {
            Message.Error("任务参数(JSON) 不可以空");
            return;
        }

        createLoading = true;
        try
        {
            using var httpResponse = await Http.PostAsJsonAsync("Operations/CreateScheduleTask", createScheduleTask, JsonHelper.SerializeOpts);

            if (httpResponse.IsSuccessStatusCode)
            {
                Message.Success("新增成功");
                isShowCreateScheduleTask = false;
                await GetTaskSettingListAsync();
            }
            else if ((int)httpResponse.StatusCode != 400)
            {
                Message.Error("新增失败");
            }
        }
        catch (HttpRequestException)
        {
            Message.Error("请求失败，请稍后重试");
        }
        finally
        {
            createLoading = false;
            StateHasChanged();
        }
    }
}
