@page "/operations/llmconversation"
@using Application.Model.LLM.LlmConversation
@using Common;
@using System.Net.Http.Json
@attribute [ReuseTabsPageTitle("LLM会话日志")]

<div class="llm-conversation-page admin-page admin-log-page">
    <div class="llm-conversation-page__hero admin-page__hero admin-page__hero--without-actions">
        <div>
            <div class="llm-conversation-page__eyebrow admin-page__eyebrow">Operations</div>
            <h2 class="llm-conversation-page__title admin-page__title">LLM 会话日志</h2>
            <div class="llm-conversation-page__subtitle admin-page__subtitle">按应用、时间范围和上下文关键字检索会话记录，快速回看 System、User 与 Assistant 内容，定位提示词与响应问题</div>
        </div>

        <div class="llm-conversation-page__stats admin-page__stats">
            <div class="llm-conversation-page__stat-card admin-page__stat-card">
                <span class="llm-conversation-page__stat-label admin-page__stat-label">会话总量</span>
                <strong class="llm-conversation-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="llm-conversation-page__stat-foot admin-page__stat-foot">当前页展示 @(pageList.List?.Count ?? 0) 条记录</span>
            </div>

            <div class="llm-conversation-page__stat-card admin-page__stat-card">
                <span class="llm-conversation-page__stat-label admin-page__stat-label">时间筛选</span>
                <strong class="llm-conversation-page__stat-value llm-conversation-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@DateRangeText()</strong>
                <span class="llm-conversation-page__stat-foot admin-page__stat-foot">支持按起止时间回溯调用过程</span>
            </div>

            <div class="llm-conversation-page__stat-card admin-page__stat-card">
                <span class="llm-conversation-page__stat-label admin-page__stat-label">检索状态</span>
                <strong class="llm-conversation-page__stat-value llm-conversation-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@(string.IsNullOrWhiteSpace(request.Keyword) ? "全部会话" : "关键词检索")</strong>
                <span class="llm-conversation-page__stat-foot admin-page__stat-foot">第 @request.Page 页 / 每页 @request.PageSize 条</span>
            </div>
        </div>
    </div>

    <Card Class="llm-conversation-page__card llm-conversation-page__card--compact admin-page__card admin-page__card--compact admin-page__card--filter">
        <Form Class="llm-conversation-page__filter-form admin-form admin-filter-form" Model="@request" Layout="@FormLayout.Inline" OnFinish="HandleSearchAsync">
            <FormItem Class="llm-conversation-page__filter-item llm-conversation-page__filter-item--keyword admin-filter-form__item--keyword">
                <Input @bind-Value="@context.Keyword" Placeholder="应用 Code / 名称 / System / User / Assistant 关键字" AllowClear />
            </FormItem>

            <FormItem Class="llm-conversation-page__filter-item llm-conversation-page__filter-item--time admin-filter-form__item--time">
                <DatePicker @bind-Value="@context.StartTime" Format="yyyy-MM-dd HH:mm:ss" ShowTime="@true" Placeholder="@("请选择开始时间")" />
            </FormItem>

            <FormItem Class="llm-conversation-page__filter-item llm-conversation-page__filter-item--time admin-filter-form__item--time">
                <DatePicker @bind-Value="@context.EndTime" Format="yyyy-MM-dd HH:mm:ss" ShowTime="@true" Placeholder="@("请选择结束时间")" />
            </FormItem>

            <FormItem Class="llm-conversation-page__filter-item llm-conversation-page__filter-item--actions admin-filter-form__item--actions">
                <div class="llm-conversation-page__filter-actions admin-filter-form__actions">
                    <Button Class="llm-conversation-page__action-button llm-conversation-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit">搜索会话</Button>
                    <Button Class="llm-conversation-page__action-button llm-conversation-page__action-button--default admin-page-button admin-page-button--default" OnClick="HandleReset">重置条件</Button>
                </div>
            </FormItem>
        </Form>
    </Card>

    <Card Class="llm-conversation-page__card llm-conversation-page__card--compact admin-page__card admin-page__card--compact">
        <div class="llm-conversation-page__list-shell admin-page-list-shell">
            <div class="llm-conversation-page__table-wrap admin-page__table-wrap admin-log-page__table-wrap">
                <Table TItem="LlmConversationDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <ActionColumn Title="应用">
                            <div class="llm-conversation-page__app-cell admin-log-page__primary-cell">
                                <div class="llm-conversation-page__app-name" title="@context.LlmAppName">@context.LlmAppName</div>
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="System">
                            <div class="llm-conversation-page__preview-cell" title="@context.SystemContent">
                                @StringHelper.SubstringText(context.SystemContent, 60)
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="User">
                            <div class="llm-conversation-page__preview-cell" title="@context.UserContent">
                                @StringHelper.SubstringText(context.UserContent, 60)
                            </div>
                        </ActionColumn>

                        <ActionColumn Title="Assistant">
                            <div class="llm-conversation-page__preview-cell" title="@context.AssistantContent">
                                @StringHelper.SubstringText(context.AssistantContent, 60)
                            </div>
                        </ActionColumn>

                        <PropertyColumn Property="c => c.CreateTime.LocalDateTime" Format="yyyy-MM-dd HH:mm" Title="时间"></PropertyColumn>

                        <ActionColumn Title="操作">
                            <Space>
                                <SpaceItem>
                                    <a class="llm-conversation-page__link admin-page__link" @onclick="() => ViewDetail(context)">查看详情</a>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="llm-conversation-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="@request.PageSize" Current="@request.Page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="1180" Visible="isShowDetail" Title='("LLM会话详情")' OnClose="() => isShowDetail = false">
    <Template>
        <div class="llm-conversation-drawer admin-detail-drawer admin-detail-drawer--log">
            <div class="llm-conversation-drawer__overview admin-detail-drawer__overview">
                <div class="llm-conversation-drawer__summary admin-detail-drawer__summary">
                    <div class="llm-conversation-drawer__summary-main">
                        <div class="llm-conversation-drawer__summary-eyebrow admin-detail-drawer__summary-eyebrow">Conversation</div>
                        <div class="llm-conversation-drawer__summary-title admin-detail-drawer__summary-title">@(string.IsNullOrWhiteSpace(detail?.LlmAppName) ? "未命名应用" : detail!.LlmAppName)</div>
                        <div class="llm-conversation-drawer__summary-subtitle admin-detail-drawer__summary-subtitle">应用 Code：@(string.IsNullOrWhiteSpace(detail?.LlmAppCode) ? "-" : detail!.LlmAppCode)</div>
                    </div>

                    <div class="llm-conversation-drawer__summary-meta admin-detail-drawer__summary-meta">
                        <span class="llm-conversation-drawer__meta-pill llm-conversation-drawer__meta-pill--time admin-detail-drawer__meta-pill">@(detail == null ? "暂无时间" : detail.CreateTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm"))</span>
                    </div>
                </div>

                <div class="llm-conversation-drawer__meta-grid admin-detail-drawer__meta-grid">
                    <div class="llm-conversation-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="llm-conversation-drawer__meta-label admin-detail-drawer__meta-label">应用ID</span>
                        <span class="llm-conversation-drawer__meta-value llm-conversation-drawer__meta-value--mono admin-detail-drawer__meta-value admin-detail-drawer__meta-value--mono">@(detail == null ? "-" : detail.LlmAppId.ToString())</span>
                    </div>

                    <div class="llm-conversation-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="llm-conversation-drawer__meta-label admin-detail-drawer__meta-label">创建人</span>
                        <span class="llm-conversation-drawer__meta-value admin-detail-drawer__meta-value">@(string.IsNullOrWhiteSpace(detail?.CreateUserName) ? "-" : detail!.CreateUserName)</span>
                    </div>

                    <div class="llm-conversation-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="llm-conversation-drawer__meta-label admin-detail-drawer__meta-label">创建人ID</span>
                        <span class="llm-conversation-drawer__meta-value llm-conversation-drawer__meta-value--mono admin-detail-drawer__meta-value admin-detail-drawer__meta-value--mono">@(detail == null ? "-" : detail.CreateUserId.ToString())</span>
                    </div>

                    <div class="llm-conversation-drawer__meta-item llm-conversation-drawer__meta-item--wide admin-detail-drawer__meta-item">
                        <span class="llm-conversation-drawer__meta-label admin-detail-drawer__meta-label">会话ID</span>
                        <span class="llm-conversation-drawer__meta-value llm-conversation-drawer__meta-value--mono admin-detail-drawer__meta-value admin-detail-drawer__meta-value--mono">@(detail == null ? "-" : detail.Id.ToString())</span>
                    </div>
                </div>
            </div>

            <div class="llm-conversation-drawer__content-grid admin-detail-drawer__content-grid">
                <div class="llm-conversation-drawer__content-box admin-detail-drawer__content-box">
                    <div class="llm-conversation-drawer__content-toolbar admin-detail-drawer__content-toolbar">
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-caption admin-detail-drawer__content-caption">System</span>
                    </div>

                    <TextArea Value="@detailSystem" ReadOnly />
                </div>

                <div class="llm-conversation-drawer__content-box admin-detail-drawer__content-box">
                    <div class="llm-conversation-drawer__content-toolbar admin-detail-drawer__content-toolbar">
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-caption admin-detail-drawer__content-caption">User</span>
                    </div>

                    <TextArea Value="@detailUser" ReadOnly />
                </div>

                <div class="llm-conversation-drawer__content-box llm-conversation-drawer__content-box--full admin-detail-drawer__content-box admin-detail-drawer__content-box--full">
                    <div class="llm-conversation-drawer__content-toolbar admin-detail-drawer__content-toolbar">
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-dot admin-detail-drawer__content-dot"></span>
                        <span class="llm-conversation-drawer__content-caption admin-detail-drawer__content-caption">Assistant</span>
                    </div>

                    <TextArea Value="@detailAssistant" ReadOnly />
                </div>
            </div>
        </div>
    </Template>
</Drawer>



@code {

    override protected async Task OnParametersSetAsync()
    {
        await GetListAsync();
    }

    LlmConversationPageRequestDto request = new() { PageSize = 10 };

    bool tableLoading = false;
    PageListDto<LlmConversationDto> pageList = new();

    async Task GetListAsync()
    {
        tableLoading = true;
        var url = StringHelper.ModelToUriParam(request, "Operations/GetLlmConversationList");
        var retData = await Http.GetFromJsonAsync<PageListDto<LlmConversationDto>>(url, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task HandleSearchAsync(EditContext editContext)
    {
        request.Page = 1;
        await GetListAsync();
    }

    async Task HandleReset()
    {
        request = new LlmConversationPageRequestDto { PageSize = request.PageSize };
        await GetListAsync();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (request.Page != args.Page)
        {
            request.Page = args.Page;
        }

        if (request.PageSize != args.PageSize)
        {
            request.PageSize = args.PageSize;
        }

        await GetListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";

    bool isShowDetail = false;
    LlmConversationDto? detail;
    string? detailSystem;
    string? detailUser;
    string? detailAssistant;


    string DateRangeText()
    {
        if (request.StartTime == null && request.EndTime == null)
        {
            return "全部时间";
        }

        if (request.StartTime != null && request.EndTime != null)
        {
            return "起止时间";
        }

        if (request.StartTime != null)
        {
            return "仅开始时间";
        }

        return "仅结束时间";
    }


    static string AppText(LlmConversationDto row) => $"{row.LlmAppCode}（{row.LlmAppName}）";

    void ViewDetail(LlmConversationDto row)
    {
        detail = row;
        detailSystem = row.SystemContent;
        detailUser = row.UserContent;
        detailAssistant = row.AssistantContent;
        isShowDetail = true;
        StateHasChanged();
    }
}
