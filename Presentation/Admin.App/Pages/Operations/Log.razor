@page "/operations/log"
@using Application.Model.Basic.Log
@attribute [ReuseTabsPageTitle("日志")]

<div class="log-page admin-page">
    <div class="log-page__hero admin-page__hero admin-page__hero--without-actions">
        <div>
            <div class="log-page__eyebrow admin-page__eyebrow">Operations</div>
            <h2 class="log-page__title admin-page__title">系统日志中心</h2>
            <div class="log-page__subtitle admin-page__subtitle">集中查看系统运行轨迹、快速筛选异常线索，并通过详情面板完成问题定位</div>
        </div>

        <div class="log-page__stats admin-page__stats">
            <div class="log-page__stat-card admin-page__stat-card">
                <span class="log-page__stat-label admin-page__stat-label">日志总量</span>
                <strong class="log-page__stat-value admin-page__stat-value">@pageList.Total</strong>
                <span class="log-page__stat-foot admin-page__stat-foot">当前已加载 @CurrentPageCount() 条</span>
            </div>

            <div class="log-page__stat-card admin-page__stat-card">
                <span class="log-page__stat-label admin-page__stat-label">筛选等级</span>
                <strong class="log-page__stat-value admin-page__stat-value">@CurrentLevelText()</strong>
                <span class="log-page__stat-foot admin-page__stat-foot">支持快速聚焦异常级别</span>
            </div>

            <div class="log-page__stat-card admin-page__stat-card">
                <span class="log-page__stat-label admin-page__stat-label">时间范围</span>
                <strong class="log-page__stat-value log-page__stat-value--small admin-page__stat-value admin-page__stat-value--small">@CurrentTimeRangeText()</strong>
                <span class="log-page__stat-foot admin-page__stat-foot">第 @request.Page 页 / 每页 @request.PageSize 条</span>
            </div>
        </div>
    </div>

    <Card Class="log-page__card log-page__card--compact log-page__filter-card admin-page__card admin-page__card--compact admin-page__card--filter-spacious">
        <Form Class="log-page__filter-form admin-form" Model="@request" Layout="@FormLayout.Vertical" OnFinish="HandleSearchAsync">
            <div class="log-page__filter-grid">
                <FormItem>
                    <div class="log-page__field-label">设备名称</div>
                    <Input @bind-Value="@context.MachineName" Placeholder="请输入设备名称" AllowClear />
                </FormItem>

                <FormItem>
                    <div class="log-page__field-label">项目名称</div>
                    <Input @bind-Value="@context.Project" Placeholder="请输入项目名称" AllowClear />
                </FormItem>

                <FormItem>
                    <div class="log-page__field-label">内容关键字</div>
                    <Input @bind-Value="@context.Content" Placeholder="请输入内容关键字" AllowClear />
                </FormItem>

                <FormItem>
                    <div class="log-page__field-label">日志等级</div>
                    <Select TItem="string" TItemValue="string" @bind-Value="@context.Level" Placeholder="请选择日志等级" AllowClear>
                        <SelectOption Value="@("Trace")" Label="Trace"></SelectOption>
                        <SelectOption Value="@("Debug")" Label="Debug"></SelectOption>
                        <SelectOption Value="@("Information")" Label="Information"></SelectOption>
                        <SelectOption Value="@("Warning")" Label="Warning"></SelectOption>
                        <SelectOption Value="@("Error")" Label="Error"></SelectOption>
                        <SelectOption Value="@("Critical")" Label="Critical"></SelectOption>
                        <SelectOption Value="@("None")" Label="None"></SelectOption>
                    </Select>
                </FormItem>

                <FormItem>
                    <div class="log-page__field-label">开始时间</div>
                    <DatePicker @bind-Value="@context.StartTime" Format="yyyy-MM-dd HH:mm:ss" ShowTime="@true" Placeholder="@("请选择开始时间")" />
                </FormItem>

                <FormItem>
                    <div class="log-page__field-label">结束时间</div>
                    <DatePicker @bind-Value="@context.EndTime" Format="yyyy-MM-dd HH:mm:ss" ShowTime="@true" Placeholder="@("请选择结束时间")" />
                </FormItem>
            </div>

            <div class="log-page__filter-footer">
                <div class="log-page__section-tools log-page__section-tools--footer">
                    <Button Class="log-page__action-button log-page__action-button--primary admin-page-button admin-page-button--primary" Type="@ButtonType.Primary" HtmlType="submit">搜索日志</Button>
                    <Button Class="log-page__action-button log-page__action-button--default admin-page-button admin-page-button--default" OnClick="HandleReset">重置条件</Button>
                </div>
            </div>
        </Form>
    </Card>

    <Card Class="log-page__card log-page__card--compact log-page__list-card admin-page__card admin-page__card--compact">
        <div class="log-page__list-shell admin-page-list-shell">
            <div class="log-page__table-wrap admin-page__table-wrap">
                <Table TItem="LogDto" DataSource="@pageList.List" Total="@pageList.Total" Loading="tableLoading" RemoteDataSource>

                    <ColumnDefinitions>
                        <PropertyColumn Property="c => c.Project" Title="项目"></PropertyColumn>
                        <PropertyColumn Property="c => c.MachineName" Title="机器"></PropertyColumn>
                        <ActionColumn Title="等级">
                            <Tag Color="@LogLevelColor(context.Level)">@LogLevelText(context.Level)</Tag>
                        </ActionColumn>
                        <PropertyColumn Property="c => c.Category" Title="类别"></PropertyColumn>
                        <PropertyColumn Property="c => c.CreateTime.LocalDateTime" Format="yyyy-MM-dd HH:mm" Title="时间"></PropertyColumn>
                        <ActionColumn Title="操作">
                            <Space>
                                <SpaceItem>
                                    <a class="log-page__detail-link admin-page__link" @onclick="() => ViewLog(context)">查看详情</a>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>

                    <PaginationTemplate>
                        <div class="log-page__pagination admin-page-list-pagination">
                            <Pagination Total="@pageList.Total" PageSize="@request.PageSize" Current="@request.Page" ShowSizeChanger OnChange="PageChange" ShowQuickJumper ShowTotal="showTotal" />
                        </div>
                    </PaginationTemplate>

                </Table>
            </div>
        </div>
    </Card>
</div>


<Drawer Closable="true" Width="900" Visible="isShowDetail" Title='("日志详情")' OnClose="() => isShowDetail = false">
    <Template>
        <div class="log-drawer admin-detail-drawer">
            <div class="log-drawer__overview admin-detail-drawer__overview">
                <div class="log-drawer__summary admin-detail-drawer__summary">
                    <div class="log-drawer__summary-main">
                        <div class="log-drawer__summary-eyebrow admin-detail-drawer__summary-eyebrow">LOG ENTRY</div>
                        <div class="log-drawer__summary-title admin-detail-drawer__summary-title">@detail?.Project</div>
                    </div>

                    <div class="log-drawer__summary-meta admin-detail-drawer__summary-meta">
                        <Tag Class="log-drawer__meta-pill log-drawer__meta-pill--level admin-detail-drawer__meta-pill" Color="@LogLevelColor(detail?.Level)">@LogLevelText(detail?.Level)</Tag>
                        <span class="log-drawer__meta-pill log-drawer__meta-pill--time admin-detail-drawer__meta-pill">@DetailTimeText()</span>
                    </div>
                </div>

                <div class="log-drawer__meta-grid admin-detail-drawer__meta-grid">
                    <div class="log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="log-drawer__meta-label admin-detail-drawer__meta-label">机器</span>
                        <span class="log-drawer__meta-value admin-detail-drawer__meta-value">@detail?.MachineName</span>
                    </div>

                    <div class="log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="log-drawer__meta-label admin-detail-drawer__meta-label">类别</span>
                        <span class="log-drawer__meta-value admin-detail-drawer__meta-value">@detail?.Category</span>
                    </div>

                    <div class="log-drawer__meta-item admin-detail-drawer__meta-item">
                        <span class="log-drawer__meta-label admin-detail-drawer__meta-label">Id</span>
                        <span class="log-drawer__meta-value log-drawer__meta-value--mono admin-detail-drawer__meta-value admin-detail-drawer__meta-value--mono">@detail?.Id</span>
                    </div>
                </div>
            </div>

            <div class="log-drawer__content-box admin-detail-drawer__content-box">
                <div class="log-drawer__content-toolbar admin-detail-drawer__content-toolbar">
                    <span class="log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                    <span class="log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                    <span class="log-drawer__content-dot admin-detail-drawer__content-dot"></span>
                    <span class="log-drawer__content-caption admin-detail-drawer__content-caption">日志原文</span>
                </div>

                <TextArea @bind-Value="@detailContent" ReadOnly />
            </div>
        </div>
    </Template>
</Drawer>



@code {

    List<string> functionList = new();

    override protected async Task OnInitializedAsync()
    {
        functionList = await userContextService.GetFunctionList();
    }

    override protected async Task OnParametersSetAsync()
    {
        await GetLogListAsync();
    }

    LogPageRequestDto request = new() { PageSize = 10 };

    bool tableLoading = false;
    PageListDto<LogDto> pageList = new();

    async Task GetLogListAsync()
    {
        tableLoading = true;
        var url = StringHelper.ModelToUriParam(request, "Operations/GetLogList");
        var retData = await Http.GetFromJsonAsync<PageListDto<LogDto>>(url, JsonHelper.DeserializeOpts);

        if (retData != null)
        {
            pageList = retData;
        }

        tableLoading = false;
        StateHasChanged();
    }

    async Task HandleSearchAsync(EditContext editContext)
    {
        request.Page = 1;
        await GetLogListAsync();
    }

    async Task HandleReset()
    {
        request = new LogPageRequestDto { PageSize = request.PageSize };
        await GetLogListAsync();
    }

    async Task PageChange(PaginationEventArgs args)
    {
        if (request.Page != args.Page)
        {
            request.Page = args.Page;
        }

        if (request.PageSize != args.PageSize)
        {
            request.PageSize = args.PageSize;
        }

        await GetLogListAsync();
    }

    Func<PaginationTotalContext, string> showTotal = pageList => $"共 {pageList.Total} 条";

    bool isShowDetail = false;
    LogDto? detail;
    string? detailContent;

    /// <summary>
    /// 返回当前页已加载的日志数量
    /// </summary>
    int CurrentPageCount() => pageList.List?.Count ?? 0;


    /// <summary>
    /// 返回当前等级筛选文案
    /// </summary>
    string CurrentLevelText() => string.IsNullOrWhiteSpace(request.Level) ? "全部等级" : request.Level;


    /// <summary>
    /// 返回当前时间范围文案
    /// </summary>
    string CurrentTimeRangeText()
    {
        if (request.StartTime == null && request.EndTime == null)
        {
            return "全部时间";
        }

        var startText = request.StartTime?.ToString("MM-dd HH:mm") ?? "未设开始";
        var endText = request.EndTime?.ToString("MM-dd HH:mm") ?? "未设结束";
        return $"{startText} - {endText}";
    }


    /// <summary>
    /// 返回详情中的时间文案
    /// </summary>
    string DetailTimeText() => detail == null ? "-" : detail.CreateTime.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss");


    /// <summary>
    /// 返回日志等级展示文案
    /// </summary>
    string LogLevelText(string? level) => string.IsNullOrWhiteSpace(level) ? "未知" : level;


    /// <summary>
    /// 返回日志等级标签颜色
    /// </summary>
    string LogLevelColor(string? level) => level switch
    {
        "Trace" => "#94a3b8",
        "Debug" => "#38bdf8",
        "Information" => "#3b82f6",
        "Warning" => "#f59e0b",
        "Error" => "#f97316",
        "Critical" => "#dc2626",
        "None" => "#64748b",
        _ => "#9ca3af"
    };

    void ViewLog(LogDto row)
    {
        detail = row;
        detailContent = row.Content;
        isShowDetail = true;
        StateHasChanged();
    }
}
